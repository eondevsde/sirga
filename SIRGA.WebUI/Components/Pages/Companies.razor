@page "/companies"
@using SIRGA.Domain.Entities
@using SIRGA.Domain.Enums
@using SIRGA.Application.Services
@attribute [Authorize(Roles = "EstudioContable,Sindicato,Auditor,Admin")]
@inject CompanyService CompanyService
@inject UnionService UnionService
@inject AccountingStudioService StudioService
@inject AssociationService AssociationService
@inject AlcanceAuditor Alcance
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>SIRGA - Gestión de Empresas</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Gestión de Empresas</MudText>

@* Aviso al estudio: empresas que salieron de su cartera por un traspaso que decidió el sindicato. *@
@if (_empresasQueSalieron.Any())
{
  <MudAlert Severity="Severity.Warning" Class="mb-4 alerta-cuit-neon">
    <MudText Typo="Typo.subtitle2" Class="mb-2">
      El sindicato traspasó @(_empresasQueSalieron.Count == 1 ? "una empresa" : $"{_empresasQueSalieron.Count} empresas") a otro estudio contable:
    </MudText>
    @foreach (var salida in _empresasQueSalieron)
    {
      <MudText Typo="Typo.body2">
        • <b>@salida.BusinessName</b> (@salida.Cuit) — la tenías desde @salida.From.ToLocalTime().ToString("dd/MM/yyyy")
        hasta @(salida.To?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")
        @if (!string.IsNullOrWhiteSpace(salida.CurrentStudioName))
        {
          <text>, hoy a cargo de @salida.CurrentStudioName</text>
        }
        @if (!string.IsNullOrWhiteSpace(salida.AuthorizedByUsername))
        {
          <text>. Autorizó @salida.AuthorizedByUsername</text>
        }
      </MudText>
    }
  </MudAlert>
}

<MudTable Items="@_companies" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading"
          Filter="new Func<Company,bool>(FilterFunc1)" Elevation="2">
  <ToolBarContent>
    @* A 1360x768 el titulo, el boton y cuatro filtros no entran en una sola linea (se partian en
       dos renglones): titulo y boton arriba, filtros en su propia linea. *@
    <div class="d-flex flex-wrap align-center w-100">
      <MudText Typo="Typo.h6" Class="mr-auto">Clientes / Empresas</MudText>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                 OnClick="OpenCreateDialog">Nueva Empresa</MudButton>

      <div class="d-flex flex-wrap align-center w-100 mt-2">
        <MudTextField @bind-Value="_searchString" Placeholder="Buscar empresa" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                      Style="min-width: 200px;" Immediate="true"></MudTextField>

        @* Provincia y Localidad salen de las tablas Provinces y Cities. La localidad se llena con
           las ciudades de la provincia elegida, y al cambiar de provincia se limpia si no pertenece. *@
        <MudSelect T="int?" Label="Provincia" @bind-Value="_provinceFilterId" @bind-Value:after="OnProvinceChanged"
                   Class="ml-4" Style="min-width: 180px;" Clearable="true">
          <MudSelectItem T="int?" Value="@((int?)null)">Todas</MudSelectItem>
          @foreach (var provincia in _provinces)
          {
            <MudSelectItem T="int?" Value="@((int?)provincia.Id)">@provincia.Name</MudSelectItem>
          }
        </MudSelect>

        <MudSelect T="int?" Label="Localidad" @bind-Value="_cityFilterId" @bind-Value:after="StateHasChanged"
                   Class="ml-4" Style="min-width: 200px;" Clearable="true"
                   Disabled="@(_provinceFilterId is null)">
          <MudSelectItem T="int?" Value="@((int?)null)">Todas</MudSelectItem>
          @foreach (var localidad in LocalidadesDeLaProvincia)
          {
            <MudSelectItem T="int?" Value="@((int?)localidad.Id)">@localidad.Name</MudSelectItem>
          }
        </MudSelect>

        <MudSelect T="string" Label="Estado" @bind-Value="_activeFilter" @bind-Value:after="OnActiveFilterChanged" Class="ml-4" Style="min-width: 130px;">
          <MudSelectItem Value="@("todas")">Todas</MudSelectItem>
          <MudSelectItem Value="@("activas")">Activas</MudSelectItem>
          <MudSelectItem Value="@("inactivas")">Inactivas</MudSelectItem>
        </MudSelect>
      </div>
    </div>
  </ToolBarContent>
  <HeaderContent>
    <MudTh>CUIT</MudTh>
    <MudTh>Empresa / Casa Central</MudTh>
    <MudTh>Estado</MudTh>
    <MudTh>Acciones</MudTh>
  </HeaderContent>
  <RowTemplate>
    <MudTd DataLabel="CUIT">@context.Cuit</MudTd>
    <MudTd DataLabel="Razón Social">
      <div class="d-flex align-center">
        @if (_companies.Any(c => c.ParentCompanyId == context.Id))
        {
          <MudIconButton
          Icon="@(_expandedRows.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
          OnClick="@(() => ToggleBranches(context.Id))" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
        }
        else
        {
          <div style="width: 40px;"></div>
        }
        <MudText Typo="Typo.body1"><b>@context.BusinessName</b></MudText>
      </div>
    </MudTd>
    <MudTd DataLabel="Estado">
      <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
        @(context.IsActive ? "Activa" : "Inactiva")
      </MudChip>
      @if (context.Status != CompanyStatus.Active)
      {
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">
          @GetStatusDisplay(context.Status)
        </MudChip>
      }
    </MudTd>
    <MudTd DataLabel="Acciones">
      <MudTooltip Text="Añadir Sucursal">
        <MudIconButton Icon="@Icons.Material.Filled.AddHomeWork" Color="Color.Info" Size="Size.Small"
                       OnClick="@(() => ShowBranches(context))" />
      </MudTooltip>
      <MudTooltip Text="Ver Empleados">
        <MudIconButton Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Small"
                       Href="@($"/empresa/{context.Id}/empleados")" Disabled="@(context.Status != CompanyStatus.Active)" />
      </MudTooltip>
      <MudTooltip Text="Historial de DDJJ">
        <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Info" Size="Size.Small"
                       Href="@($"/empresa/{context.Id}/historial")" Disabled="@(context.Status != CompanyStatus.Active)" />
      </MudTooltip>
      <AuthorizeView Roles="EstudioContable,Auditor,Admin" Context="nuevaDdjjContext">
        <Authorized>
          <MudTooltip Text="Nueva DDJJ">
            <MudIconButton Icon="@Icons.Material.Filled.PostAdd" Color="Color.Secondary" Size="Size.Small"
                           Href="/declarations/new" Disabled="@(context.Status != CompanyStatus.Active)" />
          </MudTooltip>
        </Authorized>
      </AuthorizeView>
      <MudTooltip Text="Estado de Cuenta">
        <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Success" Size="Size.Small"
                       Href="@($"/company/{context.Id}/balance")" Disabled="@(context.Status != CompanyStatus.Active)" />
      </MudTooltip>
      <MudTooltip Text="Editar Empresa">
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => OpenEditDialog(context))" />
      </MudTooltip>
      @if (!string.IsNullOrEmpty(context.Address))
      {
        <MudTooltip Text="Ver ubicación">
          <MudIconButton Icon="@Icons.Material.Filled.LocationOn" Color="Color.Error" Size="Size.Small"
                         Href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(context.Address)}")"
                         Target="_blank" />
        </MudTooltip>
      }
    </MudTd>
  </RowTemplate>
  <ChildRowContent>
    @if (_expandedRows.Contains(context.Id))
    {
      @foreach (var branch in _companies.Where(c => c.ParentCompanyId == context.Id))
      {
        <MudTr>
          <MudTd></MudTd>
          <MudTd Style="padding-left: 60px;">
            <div class="d-flex align-center">
              <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Class="mr-2"
                       Color="Color.Secondary" />
              <MudText Typo="Typo.body2">@branch.BranchName</MudText>
              <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-2">@branch.Address</MudChip>
            </div>
          </MudTd>
          <MudTd>
            <MudChip T="string" Color="@(branch.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
              @(branch.IsActive ? "Activa" : "Inactiva")
            </MudChip>
            @if (branch.Status != CompanyStatus.Active)
            {
              <MudChip T="string" Color="@GetStatusColor(branch.Status)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">
                @GetStatusDisplay(branch.Status)
              </MudChip>
            }
          </MudTd>
          <MudTd>
            <MudTooltip Text="Ver Empleados (Sucursal)">
              <MudIconButton Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Small"
                             Href="@($"/empresa/{branch.Id}/empleados")" />
            </MudTooltip>
            <MudTooltip Text="Estado de Cuenta">
              <MudIconButton Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Success" Size="Size.Small"
                             Href="@($"/company/{branch.Id}/balance")" />
            </MudTooltip>
            <MudTooltip Text="Editar Sucursal">
              <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                             OnClick="@(() => OpenEditDialog(branch))" />
            </MudTooltip>
            @if (!string.IsNullOrEmpty(branch.Address))
            {
              <MudTooltip Text="Ver ubicación">
                <MudIconButton Icon="@Icons.Material.Filled.LocationOn" Color="Color.Error" Size="Size.Small"
                               Href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(branch.Address)}")"
                               Target="_blank" />
              </MudTooltip>
            }
          </MudTd>
        </MudTr>
      }
    }
  </ChildRowContent>
  <PagerContent>
    <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas por página:" />
  </PagerContent>
</MudTable>

@code {
  private bool _loading = true;
  private string _searchString = "";
  // null = "Todas": antes era un string con 4 provincias hardcodeadas y sin forma de volver a todas.
  private int? _provinceFilterId;
  private int? _cityFilterId;
  private List<Province> _provinces = new();
  private List<City> _cities = new();
  private string _activeFilter = "todas";
  private List<Company> _companies = new();
  private HashSet<int> _expandedRows = new();
  private string? _username;
  // Para el estudio que está operando: se usa en el título del alta y para que la empresa quede
  // pendiente de autorización y con solicitud de vinculación (y no como alta directa).
  private int? _studioId;
  private string? _studioName;

  // Empresas que salieron de este estudio por un traspaso que decidió el sindicato: se avisa acá,
  // porque el estudio no se entera por ningún otro lado.
  private List<CompanyLeftDto> _empresasQueSalieron = new();

  protected override async Task OnInitializedAsync()
  {
    var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
    if (query.Contains("estado=activas")) _activeFilter = "activas";
    else if (query.Contains("estado=inactivas")) _activeFilter = "inactivas";

    // Provincias y ciudades para el filtro: la empresa guarda CityId y la ciudad sabe su provincia,
    // así que el filtro por provincia se resuelve con este mapa.
    try
    {
      _provinces = await UnionService.GetProvincesAsync();
      _cities = await UnionService.GetCitiesAsync();
    }
    catch (Exception ex)
    {
      Snackbar.Add("No se pudieron cargar las provincias: " + ex.Message, Severity.Warning);
    }

    await LoadCompanies();
  }

  private void OnActiveFilterChanged()
  {
    var value = _activeFilter;
    var url = value == "todas" ? "/companies" : $"/companies?estado={value}";
    _ = JS.InvokeVoidAsync("history.replaceState", null, "", url);
  }

  /// <summary>Localidades de la provincia elegida (tabla Cities), ordenadas por nombre.</summary>
  private IEnumerable<City> LocalidadesDeLaProvincia =>
      _provinceFilterId is { } provinceId
          ? _cities.Where(c => c.ProvinceId == provinceId)
                   .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
          : Enumerable.Empty<City>();

  /// <summary>
  /// Al cambiar la provincia, la localidad elegida puede no pertenecer a la nueva: en ese caso se
  /// limpia, para no quedar filtrando por una localidad de otra provincia.
  /// </summary>
  private void OnProvinceChanged()
  {
    if (_cityFilterId is { } cityId && !_cities.Any(c => c.Id == cityId && c.ProvinceId == _provinceFilterId))
      _cityFilterId = null;

    StateHasChanged();
  }

  private async Task LoadCompanies()
  {
    _loading = true;
    try
    {
      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var user = authState.User;
      _username = user.Identity?.Name;

      if (user.IsInRole("EstudioContable"))
      {
        var studio = await StudioService.GetByUsernameAsync(_username ?? "");
        _studioId = studio?.Id;
        _studioName = studio?.Name;

        // Aviso por las empresas que el sindicato traspasó a otro estudio (sale del historial).
        _empresasQueSalieron = _studioId is { } studioId
            ? (await AssociationService.GetCompaniesLeftAsync(studioId)).ToList()
            : new List<CompanyLeftDto>();
      }

      // Alcance del rol Auditor: si el sindicato lo asignó, ve SÓLO las empresas de su sindicato; si
      // todavía no está asignado, no ve ninguna (antes veía las 4.507 de todos los sindicatos).
      var (esAuditor, unionId) = await Alcance.ResolverAsync(user);

      if (esAuditor)
      {
        _companies = unionId is { } sindicatoId
            ? (await CompanyService.GetByUnionAsync(sindicatoId)).ToList()
            : new List<Company>();
      }
      else
      {
        // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
        _companies = (user.IsInRole("EstudioContable")
            ? await CompanyService.GetByStudioUsernameAsync(user.Identity?.Name ?? "")
            : await CompanyService.GetAllOrderedAsync()).ToList();
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar empresas: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private void ToggleBranches(int id)
  {
    if (_expandedRows.Contains(id))
      _expandedRows.Remove(id);
    else
      _expandedRows.Add(id);
  }

  private Color GetStatusColor(CompanyStatus status) => status switch
  {
    CompanyStatus.Active => Color.Success,
    CompanyStatus.PendingAuthorization => Color.Warning,
    CompanyStatus.Suspended => Color.Error,
    CompanyStatus.Rejected => Color.Dark,
    _ => Color.Default
  };

  private string GetStatusDisplay(CompanyStatus status) => status switch
  {
    CompanyStatus.Active => "Activa",
    CompanyStatus.PendingAuthorization => "Pendiente",
    CompanyStatus.Suspended => "Suspendida",
    CompanyStatus.Rejected => "Rechazada",
    _ => status.ToString()
  };

  private async Task ShowBranches(Company company)
  {
    var parameters = new DialogParameters { ["MainCompany"] = company };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    
    await DialogService.ShowAsync<CompanyBranchesDialog>("Sucursales de " + company.BusinessName, parameters, options);
    await LoadCompanies(); // Recargar por si se agregaron sucursales
  }

  private bool FilterFunc1(Company element)
  {
    // Solo mostramos las casas centrales en el listado principal (las que no tienen ParentCompanyId)
    if (element.ParentCompanyId != null)
      return false;

    // Filtro por provincia: la empresa tiene CityId, la ciudad tiene ProvinceId. Si la empresa no
    // tiene localidad cargada, no entra en ninguna provincia. (Antes comparaba la provincia contra
    // el campo Address, así que elegir una provincia dejaba la lista siempre vacía.)
    if (_provinceFilterId is { } provinceId)
    {
      var cityIdsOfProvince = _cities.Where(c => c.ProvinceId == provinceId).Select(c => c.Id).ToHashSet();
      if (element.CityId is not { } cityId || !cityIdsOfProvince.Contains(cityId))
        return false;
    }

    // Filtro por localidad (la lista se llena según la provincia elegida).
    if (_cityFilterId is { } cityFilterId && element.CityId != cityFilterId)
      return false;

    if (_activeFilter == "activas" && !element.IsActive)
      return false;

    if (_activeFilter == "inactivas" && element.IsActive)
      return false;

    if (string.IsNullOrWhiteSpace(_searchString))
      return true;
        
    if (element.Cuit.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
      return true;
        
    if (element.BusinessName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
      return true;
        
    return false;
  }

  private async Task OpenCreateDialog()
  {
    var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };

    // El título lo arma el propio diálogo con el nombre del estudio (StudioName).
    // Al estudio se le pasa su id para que el alta quede pendiente de autorización y genere la
    // solicitud de vinculación; el Admin (sin estudio) mantiene el alta directa.
    var parameters = new DialogParameters<AddCompanyDialog>
    {
      { x => x.CurrentStudioId, _studioId },
      { x => x.CurrentUsername, _username },
      { x => x.StudioName, _studioName }
    };

    var dialog = await DialogService.ShowAsync<AddCompanyDialog>("Registrar Nueva Empresa", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled)
    {
      await LoadCompanies();
    }
  }

  private async Task OpenEditDialog(Company company)
  {
    var parameters = new DialogParameters<AddCompanyDialog>
    {
      { x => x.CompanyToEdit, company },
      { x => x.CurrentUsername, _username }
    };
    var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
    var dialog = await DialogService.ShowAsync<AddCompanyDialog>("Editar Empresa", parameters, options);
    var result = await dialog.Result;

    if (result != null && !result.Canceled)
    {
      await LoadCompanies();
    }
  }
}



@using SIRGA.Domain.Entities
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject UnionService UnionService
@inject CompanyService CompanyService
@inject CompanyValidationService ValidationService

<MudDialog>
  @* El título lo define el propio diálogo (el que se pasa al abrirlo queda tapado por este
     bloque). Si viene el nombre del estudio, se aclara para qué estudio se registra la empresa. *@
  <TitleContent>
    <MudText Typo="Typo.h6">@Titulo</MudText>
  </TitleContent>
  <DialogContent>
    <MudForm @ref="_form" @bind-IsValid="@_success">
      @* Si el CUIT ya pertenece a otro estudio, se bloquea todo el formulario y queda activo sólo
         Cancelar (el botón de guardar ya viene deshabilitado). *@
      <div @attributes="BloqueoFormulario" style="@(_blockSubmit ? "opacity: .55; pointer-events: none;" : null)">
      <MudGrid>
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="CUIT" @bind-Value="_company.Cuit" Required="true" Variant="Variant.Outlined"
                        Mask="@(new PatternMask("00-00000000-0"))" Validation="@(new Func<string, string?>(ValidateCuitField))" OnBlur="HandleCuitBlur" />
        </MudItem>

        @* El aviso sale apenas se completa el CUIT, sin esperar a cargar todo el formulario:
           antes el usuario se enteraba recién al guardar, con todos los datos ya cargados. *@
        @if (_lookingUpCuit)
        {
          <MudItem xs="12">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-n2 mb-2" />
          </MudItem>
        }
        else if (AvisoCuit() is { } aviso)
        {
          @* Con contraste y efecto neón (los estilos están en AddCompanyDialog.razor.css):
             rojo cuando bloquea, cian cuando es informativo. *@
          var tono = aviso.Severidad switch
          {
            Severity.Info => " tono-info",
            Severity.Success => " tono-ok",
            _ => ""
          };
          <MudItem xs="12">
            <MudAlert Severity="@aviso.Severidad" Dense="true"
                      Class="@($"mt-n2 mb-2 alerta-cuit-neon{tono}")">@aviso.Texto</MudAlert>
          </MudItem>
        }
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Razón Social" @bind-Value="_company.BusinessName" Required="true"
                        Variant="Variant.Outlined" />
        </MudItem>
        
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Email de Contacto" @bind-Value="_company.ContactEmail" Required="true"
                        Variant="Variant.Outlined" InputType="InputType.Email" />
        </MudItem>
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Teléfono" @bind-Value="_company.Phone" Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12">
          <MudTextField T="string" Label="Dirección / Calle" @bind-Value="_company.Address" Required="true"
                        Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" md="6">
          @* T="int?" para que, sin provincia elegida, muestre la etiqueta en lugar de un "0". *@
          <MudSelect T="int?" Label="Provincia" Variant="Variant.Outlined" @bind-Value="_selectedProvinceId"
                     Required="true" SelectedValuesChanged="OnProvinceChanged">
            @foreach (var prov in _provinces)
            {
              <MudSelectItem Value="@((int?)prov.Id)">@prov.Name</MudSelectItem>
            }
          </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
          <MudSelect T="int?" Label="Localidad" Variant="Variant.Outlined" @bind-Value="_company.CityId" Required="true"
                     Disabled="@(!_cities.Any())">
            @foreach (var city in _cities)
            {
              <MudSelectItem Value="(int?)city.Id">@city.Name (@city.ZipCode)</MudSelectItem>
            }
          </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Persona de Referencia" @bind-Value="_company.ReferencePerson"
                        Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Celular de Referencia" @bind-Value="_company.ReferencePhone"
                        Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12">
          <MudCheckBox T="bool" Label="La empresa tiene múltiples sucursales" @bind-Value="_hasBranches"
                       Color="Color.Primary" />
        </MudItem>

        @if (_hasBranches)
        {
          <MudItem xs="12">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
              Esta será la <b>Casa Central</b> (Sede Administrativa). Podrás añadir más puntos de venta luego.
            </MudAlert>
          </MudItem>
          <MudItem xs="12">
            <MudTextField T="string" Label="Nombre de esta Sede (Ej: Administración, Planta Principal)"
                          @bind-Value="_company.BranchName" Required="true" Variant="Variant.Outlined" />
          </MudItem>
        }
        else
        {
          <MudHidden Hidden="true">
            <MudTextField T="string" @bind-Value="_company.BranchName" />
          </MudHidden>
        }


        @if (!IsEdit)
        {
          <MudItem xs="12">
            @* Los avisos del CUIT se muestran arriba, apenas se completa el campo: acá abajo
               quedaban fuera de la vista hasta terminar de cargar todo el formulario. *@
            <MudSelect T="int?" Label="Sindicato a Asociar" @bind-Value="_selectedUnionId" Required="true"
                       Variant="Variant.Outlined">
              @foreach (var u in _unions)
              {
                <MudSelectItem Value="(int?)u.Id">@u.Name</MudSelectItem>
              }
            </MudSelect>
          </MudItem>
        }
      </MudGrid>
      </div>
    </MudForm>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancelar</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_processing || !_success || _blockSubmit)">
      @if (_processing)
      {
        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
        <MudText Class="ms-2">Procesando...</MudText>
      }
      else
      {
        <MudText>@(IsEdit ? "Guardar Cambios" : "Registrar y Enviar Solicitud")</MudText>
      }
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
  [Parameter] public Company? CompanyToEdit { get; set; }

  private bool IsEdit => CompanyToEdit != null;
  private Company _company = new() { BusinessName = "", Address = "", BranchName = "Sede Central" };
  private bool _hasBranches;
  private List<Company> _parentCompanies = new();
  private MudForm _form = null!;
  private bool _success;
  private bool _processing;
  private List<UnionDto> _unions = new();
  private int? _selectedUnionId;
  
  private List<Province> _provinces = new();
  private List<City> _cities = new();
  private int? _selectedProvinceId;
  private CompanyLookupDto? _lookup;

  [Parameter] public int? CurrentStudioId { get; set; }
  [Parameter] public string? CurrentUsername { get; set; }

  /// <summary>Nombre del estudio para el que se registra la empresa (se muestra en el título).</summary>
  [Parameter] public string? StudioName { get; set; }

  /// <summary>Título a medida para flujos con otro texto (por ejemplo, desde el portal del estudio).</summary>
  [Parameter] public string? TituloPersonalizado { get; set; }

  private string Titulo =>
      !string.IsNullOrWhiteSpace(TituloPersonalizado) ? TituloPersonalizado!
      : IsEdit ? "Editar Empresa"
      : string.IsNullOrWhiteSpace(StudioName) ? "Registrar Nueva Empresa"
      : $"Registrar Nueva Empresa para {StudioName}";

  /// <summary>
  /// Cuando el CUIT ya pertenece a otro estudio activo (o ya es cliente de este), no tiene sentido
  /// cargar el resto del formulario: se inhabilita entero y queda activo sólo Cancelar. El aviso de
  /// arriba explica el motivo. `inert` corta también el teclado; `pointer-events` cubre navegadores
  /// viejos donde `inert` no existe.
  /// </summary>
  private Dictionary<string, object> BloqueoFormulario =>
      _blockSubmit ? new Dictionary<string, object> { ["inert"] = true } : new Dictionary<string, object>();

  private bool _blockSubmit =>
      _lookup is { AlreadyOwnedByCurrentStudio: true } or { CuitExists: true, OwnerStudioActive: true };

  private bool _lookingUpCuit;

  /// <summary>
  /// Aviso que se muestra apenas se completa el CUIT, sin esperar al final del formulario: si ya
  /// pertenece a otro estudio activo, si ya es cliente de este estudio, si existe sin dueño (al
  /// guardar se envía una solicitud de vinculación) o si aparece en el sistema anterior.
  /// </summary>
  private (Severity Severidad, string Texto)? AvisoCuit()
  {
    if (_lookup is null) return null;

    if (_lookup.AlreadyOwnedByCurrentStudio)
      return (Severity.Info, "Este CUIT ya está a tu cargo en este estudio.");

    if (_lookup.CuitExists && _lookup.OwnerStudioActive)
      return (Severity.Warning,
          $"Este CUIT ya pertenece al estudio contable '{_lookup.OwnerStudioName}', que está activo. " +
          "Para tomar estas liquidaciones, ese estudio primero tiene que liberar la empresa.");

    if (_lookup.CuitExists)
      return (Severity.Info,
          $"La empresa ya existe ({_lookup.ExistingBusinessName}) y no tiene un estudio activo: " +
          "al guardar se envía una solicitud de vinculación al sindicato.");

    if (_lookup.LegacyFound)
      return (Severity.Info,
          $"Este CUIT figura en el sistema anterior como '{_lookup.LegacyBusinessName}'. Se dará de alta como empresa nueva.");

    return (Severity.Warning,
        "Este CUIT no aparece en los registros históricos del sindicato. Verificá los datos antes de continuar.");
  }

  protected override async Task OnInitializedAsync()
  {
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      _unions = (await UnionService.GetAllAsync()).ToList();
      _provinces = await UnionService.GetProvincesAsync();
      
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      var allCompanies = (await CompanyService.GetAllOrderedAsync()).ToList();
      _parentCompanies = allCompanies.Where(c => c.ParentCompanyId == null).ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar datos iniciales: " + ex.Message, Severity.Error);
    }

    if (IsEdit && CompanyToEdit != null)
    {
      _company = new Company
      {
        Id = CompanyToEdit.Id,
        Cuit = CompanyToEdit.Cuit,
        BusinessName = CompanyToEdit.BusinessName,
        CityId = CompanyToEdit.CityId,
        BranchName = CompanyToEdit.BranchName,
        Address = CompanyToEdit.Address,
        Phone = CompanyToEdit.Phone,
        ReferencePerson = CompanyToEdit.ReferencePerson,
        ReferencePhone = CompanyToEdit.ReferencePhone,
        ContactEmail = CompanyToEdit.ContactEmail,
        AccountingStudioId = CompanyToEdit.AccountingStudioId,
        ParentCompanyId = CompanyToEdit.ParentCompanyId
      };
      
      _hasBranches = _company.ParentCompanyId.HasValue;

      if (_company.CityId.HasValue)
      {
        // Intentar pre-cargar provincia si editamos
        var cities = await UnionService.GetCitiesAsync();
        var city = cities.FirstOrDefault(c => c.Id == _company.CityId);
        if (city != null)
        {
          _selectedProvinceId = city.ProvinceId;
          _cities = await UnionService.GetCitiesByProvinceAsync(city.ProvinceId);
        }
      }
    }
  }

  private void OnParentCompanyChanged(int? parentId)
  {
    _company.ParentCompanyId = parentId;
    if (parentId.HasValue)
    {
      var parent = _parentCompanies.FirstOrDefault(c => c.Id == parentId.Value);
      if (parent != null)
      {
        _company.Cuit = parent.Cuit;
        _company.BusinessName = parent.BusinessName;
      }
    }
  }

  private string? ValidateCuitField(string value)
  {
    if (string.IsNullOrWhiteSpace(value)) return null;
    var (ok, error) = CompanyValidationService.ValidateCuit(value);
    return ok ? null : error;
  }

  private async Task HandleCuitBlur()
  {
    if (IsEdit) return;

    var norm = CompanyValidationService.NormalizeCuit(_company.Cuit);
    if (norm.Length != 11)
    {
      // Si el CUIT queda incompleto, no dejar colgado el aviso del CUIT anterior.
      _lookup = null;
      StateHasChanged();
      return;
    }

    _lookingUpCuit = true;
    StateHasChanged();

    // 1) Primero SÓLO la base propia: es instantánea y alcanza para avisar de quién es la empresa
    //    (el aviso de "ya pertenece a otro estudio" tiene que salir en el momento).
    try
    {
      _lookup = await ValidationService.LookupAsync(norm, CurrentStudioId, incluirLegado: false);
    }
    finally
    {
      _lookingUpCuit = false;
    }

    if (_lookup == null) { StateHasChanged(); return; }
    SugerirRazonSocial();
    StateHasChanged();

    // 2) Después el sistema anterior, que es el lento (decenas de segundos): sólo tiene sentido
    //    consultarlo si la empresa no existe en SIRGA, para sugerir la razón social histórica.
    if (!_lookup.CuitExists)
    {
      var conLegado = await ValidationService.LookupAsync(norm, CurrentStudioId);
      if (conLegado != null)
      {
        _lookup = conLegado;
        SugerirRazonSocial();
        StateHasChanged();
      }
    }
  }

  /// <summary>
  /// Completa la razón social con lo que se conoce: empresa existente sin dueño, o el nombre con el
  /// que figura en el sistema anterior. Nunca pisa lo que ya escribió el usuario.
  /// </summary>
  private void SugerirRazonSocial()
  {
    if (_lookup == null || !string.IsNullOrWhiteSpace(_company.BusinessName)) return;

    if (_lookup.CuitExists && !_lookup.OwnerStudioActive && !_lookup.AlreadyOwnedByCurrentStudio
        && !string.IsNullOrEmpty(_lookup.ExistingBusinessName))
    {
      _company.BusinessName = _lookup.ExistingBusinessName;
    }
    else if (!_lookup.CuitExists && _lookup.LegacyFound && !string.IsNullOrEmpty(_lookup.LegacyBusinessName))
    {
      _company.BusinessName = _lookup.LegacyBusinessName;
    }
  }

  private async Task OnProvinceChanged()
  {
    _cities = _selectedProvinceId is { } provinceId
        ? await UnionService.GetCitiesByProvinceAsync(provinceId)
        : new List<City>();
    _company.CityId = null;
    StateHasChanged();
  }

  private void Cancel() => MudDialog.Cancel();

  private async Task Submit()
  {
    await _form.ValidateAsync();
    if (!_form.IsValid) return;

    _processing = true;
    try
    {
      // Llamada directa al servicio: los endpoints ahora exigen rol y el HttpClient del
      // componente no lleva la cookie de sesión.
      var result = IsEdit
          ? await CompanyService.UpdateCompanyAsync(_company.Id, _company, CurrentUsername)
          : await CompanyService.CreateCompanyAsync(_company, CurrentStudioId, _selectedUnionId);

      if (result.Status is CompanySaveStatus.Created or CompanySaveStatus.Ok)
      {
        Snackbar.Add(IsEdit ? "Empresa actualizada exitosamente" : "Empresa registrada. Solicitud enviada al Sindicato.",
Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
      }
      else
      {
        Snackbar.Add("Error: " + (result.Message ?? "no se pudo guardar la empresa."), Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al procesar: " + ex.Message, Severity.Error);
    }
    finally
    {
      _processing = false;
    }
  }
}

@page "/subscription-expired"
@layout LoginLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
  <MudPaper Elevation="4" Class="pa-8 d-flex flex-column align-center">
    <MudIcon Icon="@Icons.Material.Filled.LockClock" Color="Color.Error" Size="Size.Large" Style="font-size: 5rem;" />
        
    <MudText Typo="Typo.h4" Color="Color.Error" Class="mt-4" Align="Align.Center">Servicio Suspendido</MudText>
        
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-6 w-100">
      El abono mensual de este Sindicato ha expirado o se encuentra inactivo.
    </MudAlert>

    <MudText Typo="Typo.body1" Class="mt-6" Align="Align.Center">
      Para restablecer el acceso a la plataforma SIRGA, por favor contacte con el Administrador Central para regularizar
      el estado de cuenta.
    </MudText>

    <MudDivider Class="my-6 w-100" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" FullWidth="true">
      Volver al Inicio
    </MudButton>
        
    <MudLink Href="/logout" Class="mt-4">Cerrar Sesión</MudLink>
  </MudPaper>
</MudContainer>

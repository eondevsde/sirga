@page "/employees"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using SIRGA.Domain.Entities
@using SIRGA.WebUI.Services
@inject EmployeeService EmployeeService
@inject AlcanceAuditor Alcance
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin,Auditor")]

<PageTitle>SIRGA - Gestión de Empleados</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
  <MudText Typo="Typo.h4" Class="mb-4">Gestión de Empleados</MudText>

  <MudTable HorizontalScrollbar="true" Items="@_employees" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading"
            Filter="new Func<EmployeeDto,bool>(FilterFunc1)">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Padrón General de Empleados</MudText>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por CUIL o Nombre" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
      <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download" Class="ml-2"
                 OnClick="DownloadPadron">Exportar Padrón</MudButton>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>CUIL</MudTh>
      <MudTh>Nombre Completo</MudTh>
      <MudTh>Fecha Ingreso</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="CUIL">@CuilFormateado(context.Dni)</MudTd>
      <MudTd DataLabel="Nombre">@context.NombreParaMostrar</MudTd>
      <MudTd DataLabel="Ingreso">@(context.JoinedDate.Year < 1950 ? "—" : context.JoinedDate.ToString("dd/MM/yyyy"))</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@(context.IsActive? Color.Success: Color.Error)" Size="Size.Small">
          @(context.IsActive ? "Activo" : "Baja")
        </MudChip>
      </MudTd>
      <MudTd DataLabel="Acciones">
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small"
                       OnClick="@(() => OnEditEmployee(context))" />
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                       OnClick="@(() => OnDeleteEmployee(context))" />
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" RowsPerPageString="Filas por página:" />
    </PagerContent>
  </MudTable>
</MudContainer>

@code {
  private bool _loading = true;
  private string _searchString = "";
  private IEnumerable<EmployeeDto> _employees = new List<EmployeeDto>();

  protected override async Task OnInitializedAsync()
  {
    await LoadEmployees();
  }

  private async Task LoadEmployees()
  {
    _loading = true;
    try
    {
      // Alcance del rol Auditor: ve SÓLO los empleados de su sindicato; si todavía no se lo
      // asignaron, no ve ninguno (antes veía los 27.934 de todos los sindicatos).
      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var (esAuditor, unionId) = await Alcance.ResolverAsync(authState.User);

      if (esAuditor)
      {
        if (unionId is { } sindicatoId)
        {
          var permitidos = await EmployeeService.GetEmployeeIdsByUnionAsync(sindicatoId);
          _employees = (await EmployeeService.GetPadronAsync())
              .Where(e => permitidos.Contains(e.Id))
              .ToList();
        }
        else
        {
          _employees = new List<EmployeeDto>();
          Snackbar.Add(
              "Todavía no te asignaron a un sindicato, por eso no ves empleados. " +
              "Pedile al sindicato que te habilite desde \"Auditores del sindicato\".",
              Severity.Warning, config => config.VisibleStateDuration = 10000);
        }
      }
      else
      {
        _employees = (await EmployeeService.GetPadronAsync()).ToList();
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar empleados: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  /// <summary>CUIL con guiones (xx-xxxxxxxx-x); en la base va sin guiones.</summary>
  private static string CuilFormateado(string? cuil) =>
      cuil is { Length: 11 } c ? $"{c[..2]}-{c[2..10]}-{c[10..]}" : cuil ?? "";
  private bool FilterFunc1(EmployeeDto element) => FilterFunc(element, _searchString);

  private bool FilterFunc(EmployeeDto element, string searchString)
  {
    if (string.IsNullOrWhiteSpace(searchString))
      return true;
    if (element.Dni.Contains(searchString, StringComparison.OrdinalIgnoreCase))
      return true;
    if (element.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
      return true;
    return false;
  }

  private async Task OnEditEmployee(EmployeeDto employee)
  {
    Snackbar.Add("Edición de empleado disponible desde la ficha de la empresa", Severity.Info);
  }

  private async Task OnDeleteEmployee(EmployeeDto employee)
  {
    // Similar al de Uniones, pero implementando el borrado real si el service lo permite
    Snackbar.Add("Acción no permitida desde el listado general", Severity.Warning);
  }

  private async Task DownloadPadron()
  {
    try
    {
      var url = $"/api/report/padron";
      await JSRuntime.InvokeVoidAsync("open", url, "_blank");
      Snackbar.Add("Generando padrón de beneficiarios...", Severity.Info);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al descargar el padrón: " + ex.Message, Severity.Error);
    }
  }
}

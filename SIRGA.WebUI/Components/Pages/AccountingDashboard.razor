@page "/estudio/dashboard"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "EstudioContable,Admin")]
@inject AccountingStudioService StudioService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<MudText Typo="Typo.h4" Class="mb-4">Dashboard: @(_studioName ?? "Estudio Contable")</MudText>

<MudGrid>
  <MudItem xs="12" sm="6" md="3">
    <MudPaper Elevation="2" Class="pa-4" Style="background-color: var(--mud-palette-primary); color: white;">
      <MudText Typo="Typo.h6">Empresas Clientes</MudText>
      <MudText Typo="Typo.h3" Style="font-size: clamp(1.1rem, 2.2vw, 2.125rem); overflow-wrap: anywhere; line-height: 1.1;">@_companies.Count</MudText>
    </MudPaper>
  </MudItem>
  <MudItem xs="12" sm="6" md="3">
    <MudPaper Elevation="2" Class="pa-4" Style="background-color: var(--mud-palette-success); color: white;">
      <MudText Typo="Typo.h6">Recaudación (Mes)</MudText>
      <MudText Typo="Typo.h3">$ @TotalRecaudado.ToString("N2")</MudText>
    </MudPaper>
  </MudItem>
</MudGrid>

<MudPaper Class="mt-6 pa-4">
  <MudTable HorizontalScroll="true" Items="@_companies" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading"
            LoadingProgressColor="Color.Info" Filter="new Func<CompanyDashboardDto,bool>(FilterFunc1)">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Mis Empresas Administradas</MudText>
      <MudSpacer />
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRequestDialog"
                 StartIcon="@Icons.Material.Filled.Add" Class="mr-4">
        Solicitar Vinculación
      </MudButton>
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por CUIT o Razón Social" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>Razón Social</MudTh>
      <MudTh>CUIT</MudTh>
      <MudTh>Último Período</MudTh>
      <MudTh>Total Declarado</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Razón Social">@context.BusinessName</MudTd>
      <MudTd DataLabel="CUIT">@context.Cuit</MudTd>
      <MudTd DataLabel="Último Período">@context.LastPeriodDeclared</MudTd>
      <MudTd DataLabel="Total Declarado">$ @context.TotalLastDeclaration.ToString("N2")</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@Textos.EstadoEmpresa(context.Status)</MudChip>
      </MudTd>
      <MudTd>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(context.Status != "Active")" OnClick="@(() => NavToNewDec(context.Id))" Class="mr-2">Declarar
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.People"
                   Disabled="@(context.Status != "Active")" OnClick="@(() => NavToEmployees(context.Id))">Empleados</MudButton>
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager />
    </PagerContent>
  </MudTable>
</MudPaper>

@code {
  private bool _loading = true;
  private string _searchString = "";
  private string? _studioName;
  private List<CompanyDashboardDto> _companies = new();
  private decimal TotalRecaudado => _companies.Sum(c => c.TotalLastDeclaration);

  protected override async Task OnInitializedAsync()
  {
    await LoadData();
  }

  private async Task LoadData()
  {
    _loading = true;
    try
    {
      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var user = authState.User;

      if (user.Identity?.IsAuthenticated == true)
      {
        var studio = await StudioService.GetByUsernameAsync(user.Identity.Name!);
        if (studio != null)
        {
          _studioName = studio.Name;
          _companies = (await StudioService.GetCompaniesForStudioAsync(studio.Id)).ToList();
        }
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar empresas: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private bool FilterFunc1(CompanyDashboardDto element) => FilterFunc(element, _searchString);

  private bool FilterFunc(CompanyDashboardDto element, string searchString)
  {
    if (string.IsNullOrWhiteSpace(searchString)) return true;
    if (element.BusinessName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
    if (element.Cuit.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
    return false;
  }

  private Color GetStatusColor(string status) => status switch
  {
    "Pagado" => Color.Success,
    "Pendiente" => Color.Warning,
    "Sin Presentar" => Color.Error,
    _ => Color.Default
  };

  private void NavToNewDec(int companyId)
  {
    // En un futuro redirigir a la declaración con el ID de empresa ya seteado
  }

  private void NavToEmployees(int companyId)
  {
    Navigation.NavigateTo($"/empresa/{companyId}/empleados");
  }

  private async Task OpenRequestDialog()
  {
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    
    if (user.Identity?.IsAuthenticated == true)
    {
      var studio = await StudioService.GetByUsernameAsync(user.Identity.Name!);
      if (studio != null)
      {
        var parameters = new DialogParameters<AddCompanyDialog>
        {
          { x => x.CurrentStudioId, studio.Id },
          { x => x.StudioName, studio.Name },
          { x => x.TituloPersonalizado, $"Solicitar Nueva Vinculación de Empresa para {studio.Name}" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddCompanyDialog>("Solicitar Nueva Vinculación de Empresa",
            parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
          await LoadData();
        }
      }
    }
  }
}

@page "/union/studios"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using SIRGA.Domain.Entities
@attribute [Authorize(Roles = "Sindicato,Auditor,Admin")]
@inject HttpClient Http
@inject AccountingStudioService StudioService
@inject UnionService UnionService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>SIRGA - Estudios Contables y Empresas</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Estudios Contables Registrados</MudText>

<MudGrid>
  <MudItem xs="12" md="5">
    <MudTable HorizontalScrollbar="true" Items="@_studios" Hover="true" Dense="true" SelectedItem="@_selectedStudio"
              OnRowClick="@((TableRowClickEventArgs<AccountingStudioDto> args) => args.Item is { } estudio ? OnStudioSelected(estudio) : Task.CompletedTask)"
              Loading="@_loadingStudios" T="AccountingStudioDto" Class="mb-4">
      <ToolBarContent>
        <MudText Typo="Typo.h6">Estudios</MudText>
        <MudSpacer />
      </ToolBarContent>
      <HeaderContent>
        <MudTh>Nombre / Estudio</MudTh>
        <MudTh>Responsable</MudTh>
      </HeaderContent>
      <RowTemplate Context="studioContext">
        <MudTd DataLabel="Nombre">@studioContext.Name</MudTd>
        <MudTd DataLabel="Responsable">@studioContext.ResponsibleUsername</MudTd>
      </RowTemplate>
      <PagerContent>
        <MudTablePager InfoFormat="Mostrando {first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
      </PagerContent>
    </MudTable>
  </MudItem>

  <MudItem xs="12" md="7">
    @if (_selectedStudio == null)
    {
      <MudAlert Severity="Severity.Info">Seleccione un estudio contable para ver sus empresas a cargo.</MudAlert>
    }
    else
    {
      <MudTable HorizontalScrollbar="true" Items="@_companies" Hover="true" Dense="true" Loading="@_loadingCompanies" T="CompanyDashboardDto">
        <ToolBarContent>
          <MudText Typo="Typo.h6">Empresas de: @_selectedStudio.Name</MudText>
          <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
          <MudTh>Razón Social</MudTh>
          <MudTh>CUIT</MudTh>
          <MudTh>Estado</MudTh>
          <MudTh>Últ. DDJJ</MudTh>
          <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate Context="companyContext">
          <MudTd DataLabel="Razón Social">@companyContext.BusinessName</MudTd>
          <MudTd DataLabel="CUIT">@companyContext.Cuit</MudTd>
          <MudTd DataLabel="Estado">
            <MudChip T="string" Color="@GetStatusColor(companyContext.Status)" Size="Size.Small">
              @GetStatusDisplay(companyContext.Status)
            </MudChip>
          </MudTd>
          <MudTd DataLabel="Últ. DDJJ">@companyContext.LastPeriodDeclared</MudTd>
          <MudTd DataLabel="Acciones">
            @* El traspaso lo decide y ejecuta el admin del SINDICATO: al auditor no se le ofrece la
               acción (probando desde la pantalla se descubrió que podía apretarla y que, al no tener
               sindicato propio, rompía el guardado). El servicio además exige el sindicato que la
               autoriza, así que tampoco puede ejecutarla el Admin. *@
            <AuthorizeView Roles="Sindicato">
              <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                         StartIcon="@Icons.Material.Filled.SwapHoriz"
                         OnClick="@(() => AbrirTraspaso(companyContext))">Transferir</MudButton>
            </AuthorizeView>
          </MudTd>
        </RowTemplate>
        <NoRecordsContent>
          <MudText>Este estudio no tiene empresas aprobadas a su cargo.</MudText>
        </NoRecordsContent>
      </MudTable>
    }
  </MudItem>
</MudGrid>

@code {
  private List<AccountingStudioDto> _studios = new();
  private AccountingStudioDto? _selectedStudio;
  private List<CompanyDashboardDto> _companies = new();
  private bool _loadingStudios = true;
  private bool _loadingCompanies = false;

  protected override async Task OnInitializedAsync()
  {
    await LoadStudios();
  }

  private async Task LoadStudios()
  {
    try
    {
      _loadingStudios = true;

      var todos = (await StudioService.GetAllAsync()).ToList();

      // Cada sindicato ve sólo los estudios que trabajan con él: los que tienen alguna empresa con
      // empleados asignados a ese sindicato. El Admin, que no tiene sindicato, ve todos.
      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var user = authState.User;
      var union = user.IsInRole("Sindicato")
          ? await UnionService.GetByUsernameAsync(user.Identity?.Name ?? "")
          : null;

      if (union is null)
      {
        _studios = todos;
      }
      else
      {
        var ids = (await StudioService.GetStudioIdsForUnionAsync(union.Id)).ToHashSet();
        _studios = todos.Where(s => ids.Contains(s.Id)).ToList();
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar estudios: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingStudios = false;
    }
  }

  private async Task OnStudioSelected(AccountingStudioDto studio)
  {
    _selectedStudio = studio;
    await LoadCompanies(studio.Id);
  }

  private async Task LoadCompanies(int studioId)
  {
    try
    {
      _loadingCompanies = true;
      _companies = (await StudioService.GetCompaniesForStudioAsync(studioId)).ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar empresas: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingCompanies = false;
    }
  }

  /// <summary>
  /// Abre el traspaso de una empresa a otro estudio. Lo ejecuta el admin del sindicato: el estudio no
  /// puede pedirlo. Los destinos posibles son los otros estudios que trabajan con este sindicato, que
  /// es la misma lista que ya se ve a la izquierda.
  /// </summary>
  private async Task AbrirTraspaso(CompanyDashboardDto company)
  {
    if (_selectedStudio is not { } origen) return;

    var destinos = _studios.Where(e => e.Id != origen.Id).ToList();
    if (destinos.Count == 0)
    {
      Snackbar.Add("No hay otro estudio que trabaje con este sindicato para transferirla.", Severity.Warning);
      return;
    }

    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    var union = await UnionService.GetByUsernameAsync(user.Identity?.Name ?? string.Empty);

    var parametros = new DialogParameters<TransferCompanyDialog>
    {
      { x => x.CompanyId, company.Id },
      { x => x.CompanyName, company.BusinessName },
      { x => x.CurrentStudioName, origen.Name },
      { x => x.UnionId, union?.Id ?? 0 },
      { x => x.AuthorizedBy, user.Identity?.Name },
      { x => x.EstudiosDestino, destinos }
    };

    var dialogo = await DialogService.ShowAsync<TransferCompanyDialog>("Transferir empresa", parametros,
        new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });

    if (await dialogo.Result is { Canceled: false })
    {
      // Refrescar: la empresa pudo haber salido de este estudio y el historial cambió.
      await LoadCompanies(origen.Id);
      await LoadStudios();
    }
  }

  private Color GetStatusColor(string status) => status switch
  {
    "Active" => Color.Success,
    "PendingAuthorization" => Color.Warning,
    "Inactive" => Color.Error,
    _ => Color.Default
  };

  private string GetStatusDisplay(string status) => status switch
  {
    "Active" => "Activa",
    "PendingAuthorization" => "Pendiente",
    "Inactive" => "Inactiva",
    "Rejected" => "Rechazada",
    _ => status
  };
}

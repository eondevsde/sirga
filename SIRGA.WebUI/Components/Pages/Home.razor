@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@attribute [Authorize]

<PageTitle>SIRGA - Inicio</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("EstudioContable"))
        {
            NavManager.NavigateTo("/companies");   // El Portal Estudio se elimino: la pantalla de empresas es la entrada
        }
        else if (user.IsInRole("Sindicato"))
        {
            NavManager.NavigateTo("/sindicato/dashboard");
        }
        else if (user.IsInRole("Admin") || user.IsInRole("Auditor"))
        {
            NavManager.NavigateTo("/audit/dashboard");
        }
    }
}

<MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary" Class="font-weight-bold">Panel de Control</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-8 mud-text-secondary">Bienvenido al Sistema Integral de Recaudación y Gestión

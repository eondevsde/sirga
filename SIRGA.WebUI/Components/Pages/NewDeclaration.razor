@page "/declarations/new"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "EstudioContable,Auditor,Admin")]
@using SIRGA.Domain.Entities
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@inject HttpClient Http
@inject SalaryScaleService ScaleService
@inject CompanyService CompanyService
@inject UnionService UnionService
@inject DeclarationService DeclarationService
@inject IPaymentService PaymentService
@inject EmployeeService EmployeeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject SIRGA.Application.Services.PdfReportService PdfService
@inject SIRGA.Application.Services.BoletaService BoletaService
@inject SIRGA.WebUI.Services.BoletaPdfService BoletaPdfService
@inject IJSRuntime JSRuntime

<PageTitle>SIRGA - Nueva DDJJ</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Nueva Declaración Jurada</MudText>

@if (_loadingBaseData)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
  <MudStepper @ref="_stepper" CenterLabels="true" Class="mud-width-full">
    <MudStep Title="Empresa y Periodo">
      <MudCard Elevation="0">
        <MudCardContent>
          <MudGrid>
            <MudItem xs="12" sm="5">
              @* T="int?" para que, sin empresa elegida, muestre la etiqueta en lugar de un "0". *@
              <MudSelect T="int?" Label="Empresa (Casa Central)" Variant="Variant.Outlined"
                         AnchorOrigin="Origin.BottomCenter" Value="_selectedParentId"
                         ValueChanged="@(async (int? val) => await OnParentCompanyChanged(val))">
                @foreach (var comp in _parentCompanies)
                {
                  @* El Value tiene que ser int? para que coincida con el T del MudSelect: si el ítem
                     queda en int, MudBlazor no puede convertir el padre y el render explota. *@
                  <MudSelectItem Value="@((int?)comp.Id)">@comp.BusinessName (@comp.Cuit)</MudSelectItem>
                }
              </MudSelect>
            </MudItem>

            @if (_branches.Any())
            {
              <MudItem xs="12" sm="4">
                <MudSelect T="int" Label="Sucursal / Sede" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                           @bind-Value="_selectedCompanyId" SelectedValuesChanged="OnBranchChanged">
                  @foreach (var branch in _branches)
                  {
                    <MudSelectItem Value="@branch.Id">@branch.BranchName - @branch.Address</MudSelectItem>
                  }
                </MudSelect>
              </MudItem>
            }

            <MudItem xs="12" sm="4">
              <MudSelect T="int" Label="Sindicato" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                         @bind-Value="_selectedUnionId" SelectedValuesChanged="OnFiltersChanged">
                @foreach (var union in _unions)
                {
                  <MudSelectItem Value="@union.Id">@union.Name - @union.JurisdictionProvince</MudSelectItem>
                }
              </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" Class="mt-2">
              <MudNumericField T="int" Value="_year" Label="Año" Variant="Variant.Outlined" Min="2020" Max="2030"
                               ValueChanged="OnYearChanged" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="mt-2">
              <MudSelect T="int" Value="_month" Label="Mes" Variant="Variant.Outlined" ValueChanged="OnMonthChanged"
                         AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="1">Enero</MudSelectItem>
                <MudSelectItem Value="2">Febrero</MudSelectItem>
                <MudSelectItem Value="3">Marzo</MudSelectItem>
                <MudSelectItem Value="4">Abril</MudSelectItem>
                <MudSelectItem Value="5">Mayo</MudSelectItem>
                <MudSelectItem Value="6">Junio</MudSelectItem>
                <MudSelectItem Value="7">Julio</MudSelectItem>
                <MudSelectItem Value="8">Agosto</MudSelectItem>
                <MudSelectItem Value="9">Septiembre</MudSelectItem>
                <MudSelectItem Value="10">Octubre</MudSelectItem>
                <MudSelectItem Value="11">Noviembre</MudSelectItem>
                <MudSelectItem Value="12">Diciembre</MudSelectItem>
              </MudSelect>
            </MudItem>
          </MudGrid>
        </MudCardContent>
      </MudCard>
    </MudStep>
        
    <MudStep Title="Detalle de Empleados">
      @if (_loadingEmployees)
      {
        <MudProgressCircular Color="Color.Default" Indeterminate="true" />
      }
      else
      {
        @if (_pluriempleos.Any())
        {
          @* Aviso de pluriempleo. No bloquea: la cuota socio es por empresa, así que el doble aporte
             es correcto y la DDJJ se puede presentar. Queda marcada como documentación pendiente. *@
          <MudAlert Severity="Severity.Warning" Class="mb-4 alerta-cuit-neon">
            <b>Pluriempleo:</b> @_pluriempleos.Count empleado(s) de esta declaración están declarados también en
            otra empresa: @string.Join(", ", _details.Where(d => _pluriempleos.ContainsKey(d.EmployeeId)).Select(d => d.EmployeeName).Take(6)).
            <br />
            Podés presentar la DDJJ igual: queda marcada como <b>documentación pendiente</b> hasta que el
            sindicato apruebe el legajo de pluriempleo (nota firmada y, si la tenés, el certificado de alta ante ARCA).
          </MudAlert>
        }

        <MudStack Row="true" Class="mb-4" AlignItems="AlignItems.Center">
          <MudAlert Severity="Severity.Info" Class="flex-grow-1">Ingrese las remuneraciones brutas para cada empleado
            activo.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="OpenAddEmployeeDialog">
              Agregar Empleado
            </MudButton>
            <div class="mud-input-control mud-button-root">
              <label
                class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mud-ripple"
                for="salaries-upload">
                <span class="mud-button-label">
                  <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-2" />
                  Carga masiva (Excel)
                </span>
              </label>
              <InputFile id="salaries-upload" OnChange="OnExcelFileSelected" style="display:none" accept=".xlsx" />
            </div>
          </MudStack>
          <MudTable Items="@_details" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
              <MudTh>Empleado</MudTh>
              <MudTh>Categoría</MudTh>
              <MudTh>Jornada</MudTh>
              <MudTh>Remuneración</MudTh>
              <MudTh>Mínimo Escala</MudTh>
              <MudTh>@($"Aporte Ley ({LawPercent:0.##}%)")</MudTh>
              <MudTh>@($"Aporte Vol. ({MemberPercent:0.##}%)")</MudTh>
              <MudTh>Total</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd DataLabel="Empleado">
                @context.EmployeeName
                @* Pluriempleo: se puede declarar igual (la cuota socio es por empresa), pero queda
                   marcado para que no pase desapercibido y para pedir el legajo. *@
                @if (_pluriempleos.ContainsKey(context.EmployeeId))
                {
                  <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">Pluriempleo</MudChip>
                }
              </MudTd>
              <MudTd DataLabel="Categoría">
                @* El cambio se PERSISTE en la asignación: el servicio que guarda la DDJJ lee la
                   categoría de la base, así que si sólo cambiara la pantalla, el mínimo calculado y
                   el guardado serían distintos. *@
                <MudSelect T="string" Value="@context.CategoryCode"
                           ValueChanged="@(async (string v) => await OnCategoryChanged(context, v))" Margin="Margin.Dense">
                  @foreach (var scale in _currentScales)
                  {
                    <MudSelectItem T="string" Value="@scale.CategoryCode">@scale.CategoryName</MudSelectItem>
                  }
                </MudSelect>
              </MudTd>
              <MudTd DataLabel="Jornada">
                @* MudSelect y MudSelectItem comparten el tipo (JornadaType) a propósito: si no
                   coinciden, MudBlazor no puede convertir el padre y mata el circuito. *@
                <MudSelect T="JornadaType" Value="@context.Jornada"
                           ValueChanged="@(async (JornadaType v) => await OnJornadaChanged(context, v))" Margin="Margin.Dense">
                  <MudSelectItem T="JornadaType" Value="@JornadaType.Completa">Completa</MudSelectItem>
                  <MudSelectItem T="JornadaType" Value="@JornadaType.Parcial">Parcial (50%)</MudSelectItem>
                </MudSelect>
              </MudTd>
              <MudTd DataLabel="Remuneración">
                @* Es el importe del recibo de sueldo, lo carga el estudio a mano. No se prellena. *@
                <MudNumericField Value="context.GrossSalary" Format="G" Variant="Variant.Text" Margin="Margin.Dense"
                                 T="decimal" ValueChanged="@((v) => { context.GrossSalary = v; Recalculate(context); })"
                                 Error="@context.IsUnderScale" ErrorText="Debajo de escala" />
              </MudTd>
              <MudTd DataLabel="Mínimo Escala">
                @if (context.MinSalary <= 0)
                {
                  @* Un cero acá NO significa que el sueldo esté bien: significa que no hay escala
                     para esa categoría. Se dice explícitamente para que nadie lo lea al revés. *@
                  <MudText Typo="Typo.body2" Color="Color.Warning">Sin escala para la categoría</MudText>
                }
                else
                {
                  <MudText Typo="Typo.body2">@context.MinSalary.ToString("C")</MudText>
                  <MudChip T="string" Size="Size.Small" Color="@ColorComparacion(context.Comparacion)">
                    @TextoComparacion(context.Comparacion)
                  </MudChip>
                  <MudText Typo="Typo.caption">
                    Básico @context.Basico.ToString("C")
                    + antig. @context.AniosAntiguedad año(s) @context.AntiguedadImporte.ToString("C")
                    + NR @context.NoRemunerativo.ToString("C")
                  </MudText>
                  @if (context.AntiguedadPercentage <= 0)
                  {
                    @* La escala no tiene cargado el % de antigüedad, así que la antigüedad suma
                       cero y el mínimo queda por debajo del real. No se calla. *@
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Escala sin % de antigüedad</MudChip>
                  }
                }
              </MudTd>
              <MudTd DataLabel="Aporte Ley">@context.LawContribution.ToString("C")</MudTd>
              <MudTd DataLabel="Aporte Vol.">@context.VoluntaryContribution.ToString("C")</MudTd>
              <MudTd DataLabel="Total"><b>@((context.LawContribution + context.VoluntaryContribution).ToString("C"))</b>
              </MudTd>
            </RowTemplate>
            <FooterContent>
              <MudTFootRow>
                <MudTd colspan="7" Style="text-align:right">Total General:</MudTd>
                <MudTd><b>@_details.Sum(x => x.LawContribution + x.VoluntaryContribution).ToString("C")</b></MudTd>
              </MudTFootRow>
            </FooterContent>
          </MudTable>
        }
      </MudStep>

      <MudStep Title="Resumen y Presentación">
        <MudGrid>
          <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
              <MudText Typo="Typo.h6">Resumen de Liquidación</MudText>
              <MudDivider Class="my-2" />
              <div class="d-flex justify-space-between">
                <MudText>Total Aportes Ley:</MudText>
                <MudText Typo="Typo.body1">@_details.Sum(x => x.LawContribution).ToString("C")</MudText>
              </div>
              <div class="d-flex justify-space-between">
                <MudText>Total Aportes Voluntarios:</MudText>
                <MudText Typo="Typo.body1">@_details.Sum(x => x.VoluntaryContribution).ToString("C")</MudText>
              </div>
              <MudDivider Class="my-2" />
              <div class="d-flex justify-space-between">
                <MudText Typo="Typo.h6">Total a Pagar:</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary">@_details.Sum(x => x.LawContribution +
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        x.VoluntaryContribution).ToString("C")</MudText>
                </div>
              </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
              <MudAlert Severity="Severity.Warning">Al confirmar, se generará la deuda correspondiente para el periodo
                seleccionado. Esta acción puede ser rectificada posteriormente si es necesario.</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Class="mt-4" Size="Size.Large"
                           OnClick="SubmitDeclaration" Disabled="@_submitting">
                  @if (_submitting)
                  {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Procesando...</MudText>
                  }
                  else
                  {
                    <MudText>Presentar DDJJ</MudText>
                  }
                </MudButton>

                @if (_lastResult is not null)
                {
                  <MudStack Row="true" Spacing="2" Class="mt-2" AlignItems="AlignItems.Center">
                    @if (_showPaymentButton)
                    {
                      <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                 Href="@_paymentUrl" Target="_blank" StartIcon="@Icons.Material.Filled.Payment">
                        Pagar con Mercado Pago
                      </MudButton>
                    }
                    @* La boleta del BANCO es la que se paga: va primera y con texto. El comprobante interno
                       queda como botón secundario y avisado, para no volver a confundirlos. *@
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               OnClick="ImprimirBoletaBancaria" StartIcon="@Icons.Material.Filled.Print">
                      Boleta bancaria (triplicada)
                    </MudButton>
                    <MudTooltip Text="Comprobante interno de SIRGA: NO es la boleta del banco y no lleva su código de barras">
                      <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                                 OnClick="DownloadBoleta" StartIcon="@Icons.Material.Filled.PictureAsPdf">
                        Comprobante interno
                      </MudButton>
                    </MudTooltip>
                  </MudStack>
                }
              </MudItem>
            </MudGrid>
          </MudStep>
        </MudStepper>
      }

@code {
  [CascadingParameter]
  private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

  private MudStepper _stepper = null!; // Asignado por @ref en el marcado
  private int _year = DateTime.Now.Year;
  private int _month = DateTime.Now.Month;
  private int _selectedCompanyId;
  private int _selectedUnionId;
  private bool _loadingBaseData = true;
  private bool _loadingEmployees = false;
  private bool _submitting = false;
  private bool _showPaymentButton = false;
  private string _paymentUrl = "";
  private DeclarationResponseDto? _lastResult;

  private List<Company> _companies = new();
  private List<Company> _parentCompanies = new();
  private List<Company> _branches = new();
  private int? _selectedParentId;
  private List<UnionDto> _unions = new();
  private List<SalaryScaleDto> _currentScales = new();
  private List<DeclarationDetailViewModel> _details = new();

  // Empleados de esta empresa que también están declarados en otra (pluriempleo). Se carga de UNA
  // consulta para toda la empresa (no una por empleado) y sirve para marcarlos y para el aviso.
  private IReadOnlyDictionary<int, IReadOnlyList<EmployeeService.PluriempleoDto>> _pluriempleos =
      new Dictionary<int, IReadOnlyList<EmployeeService.PluriempleoDto>>();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var authState = await AuthStateTask;
      var username = authState.User.Identity?.Name;
      
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      var rawCompanies = (string.IsNullOrEmpty(username)
          ? await CompanyService.GetAllOrderedAsync()
          : await CompanyService.GetByStudioUsernameAsync(username)).ToList();
      _companies = rawCompanies.Where(c => c.Status == SIRGA.Domain.Enums.CompanyStatus.Active).ToList();
      
      _parentCompanies = _companies.Where(c => c.ParentCompanyId == null).ToList();
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      _unions = (await UnionService.GetAllAsync()).ToList();
            
      if (!_parentCompanies.Any())
      {
        Snackbar.Add("No tiene empresas activas para declarar.", Severity.Warning);
      }
      // Quitamos la pre-selección automática para que el usuario elija y no se confunda
      /*
      else
      {
        _selectedParentId = _parentCompanies.First().Id;
        await OnParentCompanyChanged();
      }
      */

      if (_unions.Any()) _selectedUnionId = _unions.First().Id;

      await LoadScalesAsync();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar datos base: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingBaseData = false;
    }
  }

  private async Task OnParentCompanyChanged(int? val)
  {
    _selectedParentId = val;
    _branches = _companies.Where(c => c.ParentCompanyId == _selectedParentId).ToList();
    
    if (!_branches.Any())
    {
      // Caso común: No tiene sucursales, usamos la empresa madre como la sede a declarar
      _selectedCompanyId = _selectedParentId ?? 0;
    }
    else
    {
      // Tiene sucursales, obligamos a elegir una (o la primera por defecto)
      _selectedCompanyId = _branches.First().Id;
    }
    
    await OnFiltersChanged();
  }

  private async Task OnBranchChanged()
  {
    await OnFiltersChanged();
  }

  private async Task OnFiltersChanged()
  {
    _loadingEmployees = true;
    try
    {
      if (_selectedCompanyId == 0 || _selectedUnionId == 0) return;

      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      var employees = (await EmployeeService.GetEmployeesByAssignmentAsync(_selectedCompanyId, _selectedUnionId)).ToList();

      // Pluriempleo: quiénes de esta empresa están también declarados en otra. Se consulta por la
      // empresa completa en una sola operación, no empleado por empleado.
      _pluriempleos = await EmployeeService.GetPluriempleoDeEmpresaAsync(_selectedCompanyId);
      _details = employees.Select(e => new DeclarationDetailViewModel
      {
        EmployeeId = e.Id,
        AssignmentId = e.AssignmentId,
        EmployeeName = e.FullName,
        Dni = e.Dni,
        IsVoluntaryMember = e.IsVoluntaryMember,
        // Estos tres datos son los que faltaban para poder calcular el mínimo de escala: sin la
        // categoría real y la fecha de ingreso a la empresa, el mínimo daba cero o un valor falso.
        CategoryCode = e.CategoryCode,
        EntryDate = e.AssignmentEntryDate,
        Jornada = e.Jornada
      }).ToList();

      foreach (var detail in _details) Recalculate(detail);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar empleados: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingEmployees = false;
    }
  }

  private async Task OpenAddEmployeeDialog()
  {
    if (_selectedCompanyId == 0)
    {
      Snackbar.Add("Debe seleccionar una empresa primero.", Severity.Warning);
      return;
    }

    var parameters = new DialogParameters { ["CompanyId"] = _selectedCompanyId };
    var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    var dialog = await DialogService.ShowAsync<AddEmployeeDialog>("Nuevo Empleado", parameters, options);
    var result = await dialog.Result;

    if (result is { Canceled: false })
    {
      await OnFiltersChanged(); // Recargar la lista de empleados con los filtros actuales
    }
  }

  private async Task OnYearChanged(int year)
  {
    _year = year;
    await OnPeriodChanged();
  }

  private async Task OnMonthChanged(int month)
  {
    _month = month;
    await OnPeriodChanged();
  }

  private async Task OnPeriodChanged()
  {
    await LoadScalesAsync();
    foreach (var detail in _details)
    {
      UpdateMinSalary(detail);
    }
  }

  private async Task LoadScalesAsync()
  {
    try
    {
      // Las escalas y las categorías son de la RAMA del sindicato (son nacionales por convenio), no del
      // sindicato. Sin rama asignada no se puede calcular ningún mínimo.
      var ramaId = SelectedUnion?.RamaId ?? 0;
      if (ramaId == 0)
      {
        _currentScales = new();
        if (_selectedUnionId > 0)
        {
          Snackbar.Add(
              "El sindicato elegido no tiene rama de actividad asignada, así que no se pueden calcular los " +
              "mínimos de escala. Asignásela en la pantalla de Sindicatos.",
              Severity.Warning);
        }
        return;
      }

      _currentScales = await ScaleService.GetByRamaAsync(ramaId);
      // Periodo exacto; si no existe, congelar la escala más reciente anterior (fallback)
      var targetDate = new DateTime(_year, _month, 1);
      var available = _currentScales.Where(s => s.Period <= targetDate).ToList();
      if (available.Any())
      {
        var latestPeriod = available.Max(s => s.Period);
        _currentScales = available.Where(s => s.Period == latestPeriod).ToList();
      }
      else
      {
        _currentScales = new();
      }
    }
    catch (Exception ex)
    {
      // Antes esto iba sólo a la consola: la pantalla quedaba con los mínimos en cero y no había forma
      // de saber que la carga de escalas había fallado. No hay fallos silenciosos.
      Snackbar.Add("No se pudieron cargar las escalas salariales: " + ex.Message, Severity.Error);
      _currentScales = new();
    }
  }

  /// <summary>Porcentajes del sindicato elegido, leídos de su configuración (no hardcodeados): la
  /// pantalla tiene que mostrar el mismo porcentaje que el servicio aplica al guardar.</summary>
  private UnionDto? SelectedUnion => _unions.FirstOrDefault(u => u.Id == _selectedUnionId);
  private decimal LawPercent => SelectedUnion?.LawContributionPercentage ?? 2m;
  private decimal MemberPercent => SelectedUnion?.UnionMemberPercentage ?? 2m;

  private static decimal Redondear(decimal valor) => Math.Round(valor, 2, MidpointRounding.AwayFromZero);

  private void UpdateMinSalary(DeclarationDetailViewModel detail)
  {
    var scale = _currentScales?.FirstOrDefault(s => s.CategoryCode == detail.CategoryCode);
    if (scale == null)
    {
      // Sin escala para la categoría el mínimo es 0 y la comparación queda en "Sin datos": no se
      // puede decir que el sueldo está bien cuando en realidad falta la escala.
      detail.MinSalary = 0;
      detail.Basico = 0;
      detail.AntiguedadPercentage = 0;
      detail.AniosAntiguedad = 0;
      detail.AntiguedadImporte = 0;
      detail.NoRemunerativo = 0;
      detail.Comparacion = EscalaComparacion.SinDatos;
      return;
    }

    var fechaCorte = new DateTime(_year, _month, 1);
    detail.Basico = scale.BasicAmount;
    detail.AntiguedadPercentage = scale.AntiguedadPercentage;
    detail.AniosAntiguedad = SalaryMinimumCalculator.AniosAntiguedad(detail.EntryDate, fechaCorte);
    detail.AntiguedadImporte = SalaryMinimumCalculator.Antiguedad(
        scale.BasicAmount, scale.AntiguedadPercentage, detail.AniosAntiguedad);
    detail.NoRemunerativo = scale.AgreementNR1 + scale.AgreementNR2;
    detail.MinSalary = SalaryMinimumCalculator.Minimo(scale, detail.EntryDate, fechaCorte, detail.Jornada);
  }

  private void Recalculate(DeclarationDetailViewModel detail)
  {
    UpdateMinSalary(detail);
    // Se redondea con el mismo criterio que el servicio, para que el total que ve el estudio sea
    // exactamente el que se guarda.
    detail.LawContribution = Redondear(detail.GrossSalary * (LawPercent / 100m));
    detail.VoluntaryContribution = detail.IsVoluntaryMember
        ? Redondear(detail.GrossSalary * (MemberPercent / 100m))
        : 0;
    detail.Comparacion = SalaryMinimumCalculator.Comparar(detail.GrossSalary, detail.MinSalary);
  }

  /// <summary>
  /// Cambio de categoría desde la fila de la DDJJ. Se persiste en la asignación: el servicio que
  /// guarda la declaración lee la categoría de la base, así que si sólo cambiara la pantalla el
  /// mínimo mostrado y el guardado serían distintos.
  /// </summary>
  private async Task OnCategoryChanged(DeclarationDetailViewModel detail, string? categoryCode)
  {
    detail.CategoryCode = categoryCode;
    var (ok, error) = await EmployeeService.UpdateAssignmentAsync(detail.AssignmentId, categoryCode, detail.Jornada);
    if (!ok) Snackbar.Add(error ?? "No se pudo guardar la categoría.", Severity.Error);
    Recalculate(detail);
  }

  /// <summary>Cambio de jornada. Prorratea el mínimo (Parcial = 50%) y se guarda en la asignación.</summary>
  private async Task OnJornadaChanged(DeclarationDetailViewModel detail, JornadaType jornada)
  {
    detail.Jornada = jornada;
    var (ok, error) = await EmployeeService.UpdateAssignmentAsync(detail.AssignmentId, detail.CategoryCode, jornada);
    if (!ok) Snackbar.Add(error ?? "No se pudo guardar la jornada.", Severity.Error);
    Recalculate(detail);
  }

  private static Color ColorComparacion(EscalaComparacion comparacion) => comparacion switch
  {
    EscalaComparacion.Debajo => Color.Error,
    EscalaComparacion.Igual => Color.Success,
    EscalaComparacion.Superior => Color.Info,
    _ => Color.Default
  };

  private static string TextoComparacion(EscalaComparacion comparacion) => comparacion switch
  {
    EscalaComparacion.Debajo => "Debajo de escala",
    EscalaComparacion.Igual => "Igual a escala",
    EscalaComparacion.Superior => "Superior a escala",
    _ => "Sin escala"
  };

  private async Task SubmitDeclaration()
  {
    _submitting = true;
    try
    {
      var request = new DeclarationRequestDto
      {
        CompanyId = _selectedCompanyId,
        UnionId = _selectedUnionId,
        Period = $"{_year}-{_month:D2}",
        Salaries = _details.Select(d => new EmployeeSalaryDto
        {
          EmployeeId = d.EmployeeId,
          BaseSalary = d.GrossSalary
        }).ToList()
      };

      // Llamada directa al servicio. Antes se hacía por HTTP contra la propia API y, como el
      // HttpClient del componente no lleva la cookie de sesión, el endpoint [Authorize]
      // respondía 401: la DDJJ nunca se guardaba.
      _lastResult = await DeclarationService.CreateDeclarationAsync(request);
      Snackbar.Add("¡Declaración Jurada presentada con éxito!", Severity.Success);

      // Generar preferencia de pago si hay saldo positivo. Llamada directa al servicio: el
      // endpoint ahora exige rol y el HttpClient no lleva cookie. Si falla (por ejemplo, sin
      // credenciales de MercadoPago), la DDJJ ya quedó guardada y sólo se avisa.
      if (_lastResult != null && _lastResult.BalanceAmount > 0)
      {
        try
        {
          var pref = await PaymentService.CreatePaymentPreferenceAsync(_lastResult.Id);
          _paymentUrl = pref?.SandboxInitPoint ?? "";
          _showPaymentButton = true;
          Snackbar.Add("Link de pago generado. Puede proceder a pagar.", Severity.Info);
        }
        catch (Exception exPago)
        {
          Snackbar.Add("La DDJJ se guardó, pero no se pudo generar el link de pago: " + exPago.Message, Severity.Warning);
        }
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al presentar DDJJ: " + ex.Message, Severity.Error);
    }
    finally
    {
      _submitting = false;
    }
  }

  private async Task OnExcelFileSelected(InputFileChangeEventArgs e)
  {
    await UploadSalariesExcel(e.File);
  }

  private async Task UploadSalariesExcel(IBrowserFile file)
  {
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      using var stream = file.OpenReadStream(10 * 1024 * 1024); // Max 10MB
      var salaries = (await DeclarationService.ProcessExcelDeclarationAsync(stream)).ToList();
      if (salaries.Any())
      {
        foreach (var salary in salaries)
        {
          var detail = _details.FirstOrDefault(d => d.EmployeeId == salary.EmployeeId);
          if (detail != null)
          {
            detail.GrossSalary = salary.BaseSalary;
            Recalculate(detail);
          }
        }
        Snackbar.Add("Remuneraciones cargadas desde Excel con éxito.", Severity.Success);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al procesar Excel: " + ex.Message, Severity.Error);
    }
  }

  private async Task DownloadBoleta()
  {
    if (_lastResult == null) return;

    try
    {
      var pdfBytes = PdfService.GeneratePaymentBoleta(_lastResult);
      var fileName = $"Boleta_SIRGA_{_lastResult.Period}_{_lastResult.CompanyCuit}.pdf";
      var base64 = Convert.ToBase64String(pdfBytes);

      // Llamada a JS para descargar el archivo usando Base64 (compatible con App.razor)
      await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al generar PDF: " + ex.Message, Severity.Error);
    }
  }

  /// <summary>
  /// Imprime la boleta BANCARIA (la que se paga en el banco), por triplicado y con el código de barras de
  /// 58 dígitos. Es la que antes no estaba en esta pantalla: sólo se podía bajar el comprobante interno.
  ///
  /// La boleta tiene UNA sola fecha de vencimiento: si la DDJJ ya venció, se pide la fecha de pago en un
  /// modal y esa pasa a ser el vencimiento, con el interés calculado hasta ahí.
  /// </summary>
  private async Task ImprimirBoletaBancaria()
  {
    if (_lastResult is null) return;

    try
    {
      var vencimiento = await BoletaService.ObtenerVencimientoAsync(_lastResult.Id);
      DateTime? fechaPago = null;

      if (vencimiento is { Vencida: true })
      {
        var parametros = new DialogParameters
        {
          { nameof(PaymentDateDialog.Periodo), _lastResult.Period },
          { nameof(PaymentDateDialog.Vencimiento), vencimiento.Vencimiento }
        };

        var dialogo = await DialogService.ShowAsync<PaymentDateDialog>(
            "Fecha de pago de la boleta", parametros,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, CloseButton = true });

        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled || resultado.Data is not DateTime fecha) return;
        fechaPago = fecha;
      }

      var armado = await BoletaService.ArmarAsync(_lastResult.Id, fechaPago);
      if (armado.Datos is null)
      {
        Snackbar.Add(armado.Error ?? "No se pudo armar la boleta bancaria.", Severity.Error);
        return;
      }

      var datos = armado.Datos;
      var pdfBytes = BoletaPdfService.Generar(datos);
      var fileName = $"BoletaBancaria_{datos.Periodo}_{datos.Cuit}.pdf";
      await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, Convert.ToBase64String(pdfBytes));

      var detalleInteres = datos.Interes > 0
          ? $" Incluye interés por {datos.DiasInteres} día(s): {datos.Interes:C2} ({datos.InteresPorcentaje:0.####}%)."
          : " Sin interés.";

      Snackbar.Add(
          $"Boleta bancaria emitida. Vencimiento {datos.Vencimiento:dd/MM/yyyy} por {datos.ImporteTotal:C2}." +
          detalleInteres,
          Severity.Success);

      if (!string.IsNullOrWhiteSpace(armado.Advertencia))
        Snackbar.Add(armado.Advertencia, Severity.Warning);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al generar la boleta bancaria: " + ex.Message, Severity.Error);
    }
  }

  public class DeclarationDetailViewModel
  {
    public int EmployeeId { get; set; }
    public int AssignmentId { get; set; }
    public string EmployeeName { get; set; } = "";
    public string Dni { get; set; } = "";

    /// <summary>
    /// Código real de la categoría del empleado (asignación). Antes tenía el valor fijo
    /// "MAESTRANZA-A" —con guion— puesto "para prototipo", que no coincide con ningún código del
    /// sistema (los reales son "13", "2", ...), así que el mínimo de escala daba siempre cero.
    /// </summary>
    public string? CategoryCode { get; set; }

    /// <summary>Fecha de ingreso del empleado a esta empresa: desde acá se cuenta la antigüedad.</summary>
    public DateTime EntryDate { get; set; }

    public JornadaType Jornada { get; set; } = JornadaType.Completa;

    /// <summary>Importe del recibo de sueldo, cargado a mano por el estudio. No se prellena.</summary>
    public decimal GrossSalary { get; set; }

    /// <summary>
    /// Mínimo de escala: el sueldo que correspondería según escala + antigüedad + jornada (+ NR).
    /// Es sólo un valor de referencia para comparar, no reemplaza a <see cref="GrossSalary"/>.
    /// </summary>
    public decimal MinSalary { get; set; }

    public decimal Basico { get; set; }
    public decimal AntiguedadPercentage { get; set; }
    public int AniosAntiguedad { get; set; }
    public decimal AntiguedadImporte { get; set; }
    public decimal NoRemunerativo { get; set; }

    public EscalaComparacion Comparacion { get; set; } = EscalaComparacion.SinDatos;
    public bool IsUnderScale => Comparacion == EscalaComparacion.Debajo;

    public decimal LawContribution { get; set; }
    public decimal VoluntaryContribution { get; set; }
    public bool IsVoluntaryMember { get; set; }
  }

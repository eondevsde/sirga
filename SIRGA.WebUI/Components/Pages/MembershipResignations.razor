@page "/sindicato/renuncias"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using Microsoft.AspNetCore.Authorization
@inject EmployeeService EmployeeService
@inject UnionService UnionService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Sindicato,Admin")]

<MudText Typo="Typo.h4" Class="mb-4">Renuncias de Socios</MudText>
<MudText Typo="Typo.body1" Class="mb-4 mud-text-secondary">
  Solicitudes de los estudios contables para dar de baja a un empleado como socio voluntario (aporte 2%).
  Al aprobar, el cambio rige hacia adelante: las DDJJ ya presentadas no se modifican.
</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-6">
  <MudGrid>
    <MudItem xs="12" sm="6">
      <MudSelect T="int" Label="Sindicato / Filial" Variant="Variant.Outlined" Value="_selectedUnionId"
                 ValueChanged="OnUnionChanged" AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem Value="0">Seleccione un Sindicato</MudSelectItem>
        @foreach (var union in _unions)
        {
          <MudSelectItem Value="@union.Id">@union.Name (@union.JurisdictionCity)</MudSelectItem>
        }
      </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" Class="d-flex align-end">
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadRequests"
                 Disabled="@(_selectedUnionId == 0)" StartIcon="@Icons.Material.Filled.Refresh">
        Actualizar Solicitudes
      </MudButton>
    </MudItem>
  </MudGrid>
</MudPaper>

@if (_loading)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_requests == null)
{
  @if (_selectedUnionId != 0)
  {
    <MudAlert Severity="Severity.Info">Seleccione un sindicato para ver sus solicitudes.</MudAlert>
  }
}
else if (!_requests.Any())
{
  <MudAlert Severity="Severity.Info">No hay solicitudes de renuncia pendientes para este sindicato.</MudAlert>
}
else
{
  <MudTable HorizontalScrollbar="true" Items="@_requests" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Striped="true">
    <HeaderContent>
      <MudTh>Fecha</MudTh>
      <MudTh>Empleado</MudTh>
      <MudTh>DNI</MudTh>
      <MudTh>Empresa</MudTh>
      <MudTh>CUIT</MudTh>
      <MudTh>Motivo</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Fecha">@context.RequestedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
      <MudTd DataLabel="Empleado">@context.EmployeeName</MudTd>
      <MudTd DataLabel="DNI">@context.Dni</MudTd>
      <MudTd DataLabel="Empresa">@context.CompanyBusinessName</MudTd>
      <MudTd DataLabel="CUIT">@context.CompanyCuit</MudTd>
      <MudTd DataLabel="Motivo">@context.Reason</MudTd>
      <MudTd DataLabel="Acciones">
        <MudTooltip Text="Aprobar renuncia">
          <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success"
                         OnClick="@(() => ResolveRequest(context, true))" />
        </MudTooltip>
        <MudTooltip Text="Rechazar renuncia">
          <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                         OnClick="@(() => ResolveRequest(context, false))" />
        </MudTooltip>
      </MudTd>
    </RowTemplate>
  </MudTable>
}

@code {
  private int _selectedUnionId;
  private List<UnionDto> _unions = new();
  private List<MembershipResignationDto>? _requests;
  private bool _loading;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _unions = (await UnionService.GetAllAsync()).ToList();
      StateHasChanged();
    }
  }

  private async Task OnUnionChanged(int unionId)
  {
    _selectedUnionId = unionId;
    await LoadRequests();
  }

  private async Task LoadRequests()
  {
    if (_selectedUnionId == 0) return;
    _loading = true;
    StateHasChanged();
    try
    {
      _requests = (await EmployeeService.GetMembershipResignationRequestsAsync(_selectedUnionId)).ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar solicitudes: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
      StateHasChanged();
    }
  }

  private async Task ResolveRequest(MembershipResignationDto request, bool approve)
  {
    var comment = approve
        ? "Renuncia de socio aprobada por el Sindicato."
        : "Renuncia de socio rechazada. El empleado continúa siendo socio.";

    var (success, error) = await EmployeeService.ResolveMembershipResignationAsync(request.AssignmentId, approve, comment);

    if (success)
    {
      Snackbar.Add(approve ? "Renuncia aprobada. El empleado dejó de ser socio." : "Renuncia rechazada.", Severity.Success);
    }
    else
    {
      Snackbar.Add("Error: " + (error ?? "no se pudo resolver la solicitud"), Severity.Error);
    }

    await LoadRequests();
  }
}
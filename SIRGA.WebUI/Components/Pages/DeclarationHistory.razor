@page "/declarations/history"
@page "/empresa/{CompanyId:int}/historial"
@using SIRGA.Application.DTOs
@using SIRGA.Domain.Entities
@attribute [Authorize(Roles = "EstudioContable,Sindicato,Auditor,Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject SIRGA.Application.Services.DeclarationService DeclarationService
@inject SIRGA.Application.Services.CompanyService CompanyService
@inject SIRGA.Application.Services.BoletaService BoletaService
@inject SIRGA.WebUI.Services.BoletaPdfService BoletaPdfService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>SIRGA - Historial de DDJJ</PageTitle>

<MudText Typo="Typo.h4">Historial de Declaraciones Juradas</MudText>

@* Datos de la empresa: se muestran SIEMPRE (aunque la lista esté vacía), porque viniendo de
   /empresa/{id}/historial hay que saber de qué empresa es el historial. *@
@if (Empresa is { } empresa)
{
  <MudText Typo="Typo.subtitle1" Class="mt-2">
    <b>Empresa:</b> @empresa.BusinessName@(string.IsNullOrWhiteSpace(empresa.TradeName) ? "" : $" / {empresa.TradeName}")
  </MudText>
  <MudText Typo="Typo.subtitle1"><b>CUIT:</b> @empresa.Cuit</MudText>
}
<div class="mb-6"></div>

@if (_loading)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
  <MudTable Items="@_declarations" Hover="true" Dense="true" Elevation="1"
            Filter="new Func<DeclarationResponseDto,bool>(FilterFunc)">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Presentaciones Anteriores</MudText>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por Periodo" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>Fecha Presentación</MudTh>
      <MudTh>Periodo</MudTh>
      <MudTh>Sindicato</MudTh>
      <MudTh>Total</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Versión</MudTh>
      <MudTh Style="text-align:right">Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Fecha">@context.SubmissionDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
      <MudTd DataLabel="Periodo">@context.Period</MudTd>
      <MudTd DataLabel="Sindicato">@context.UnionName</MudTd>
      <MudTd DataLabel="Total">@context.TotalAmount.ToString("C2")</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Text">
          @context.Status
        </MudChip>
      </MudTd>
      <MudTd DataLabel="Versión">
        @* La v1 es la original; de la v2 en adelante son rectificativas. La versión reemplazada queda
           como antecedente con su número, así se ve la cadena. *@
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                 Color="@(context.VersionNumber > 1 ? Color.Warning : Color.Default)">
          v@(context.VersionNumber)
        </MudChip>
      </MudTd>
      <MudTd DataLabel="Acciones" Style="text-align:right">
        @* Una DDJJ REEMPLAZADA por una rectificativa no tiene NINGUNA acción y tampoco lleva leyenda (el
           usuario pidió sacarla): la fila se identifica por su estado "Rectificada" y su versión. Lo que NO
           puede pasar es que se emita su boleta, porque se cobraría dos veces la misma DDJJ. *@
        @if (context.Status != "Rectificada")
        {
          @* La boleta del BANCO: sólo el ícono de impresión (con el texto ocupaba demasiado ancho en la
             grilla). El comprobante interno se sacó de acá. *@
          <MudTooltip Text="Imprimir la boleta bancaria (triplicada, con el código de barras del banco)">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => OnImprimirBoletaBancaria(context))" />
          </MudTooltip>
          @* RECTIFICAR / CONTINUAR: manda a Nueva DDJJ con la empresa, el sindicato y el período YA elegidos.
             Sobre una DDJJ en BORRADOR la acción es CONTINUARLA (nunca se presentó, así que presentarla no es
             una rectificación); sobre una ya presentada, es una RECTIFICATIVA. *@
          var esBorrador = context.Status == "Draft";
          <MudTooltip Text="@(esBorrador
              ? "Continuar este borrador donde quedó"
              : "Presentar una versión nueva de esta DDJJ (rectificativa)")">
            <MudIconButton Icon="@(esBorrador ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.EditNote)"
                           Color="@(esBorrador ? Color.Info : Color.Warning)" Size="Size.Small"
                           OnClick="@(() => OnRectificar(context))" />
          </MudTooltip>
        }
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager InfoFormat="Mostrando {first_item}-{last_item} de {all_items}"
                     RowsPerPageString="Filas por página:" />
    </PagerContent>
  </MudTable>
}

@code {
  [Parameter] public int CompanyId { get; set; }
  private bool _loading = true;
  private string _searchString = "";
  private IEnumerable<DeclarationResponseDto> _declarations = new List<DeclarationResponseDto>();

  /// <summary>Empresa del historial, para el encabezado. Sólo viene en la ruta /empresa/{id}/historial.</summary>
  private Company? Empresa { get; set; }

  protected override async Task OnInitializedAsync()
  {
    await CargarEmpresaAsync();
    await LoadData();
  }

  /// <summary>
  /// Trae los datos de la empresa para el encabezado (Razón Social, nombre de fantasía y CUIT). Se cargan
  /// del Id de la ruta, no de la lista de DDJJ: así se muestran aunque el historial esté vacío.
  /// </summary>
  private async Task CargarEmpresaAsync()
  {
    if (CompanyId <= 0) return;

    try
    {
      Empresa = await CompanyService.GetByIdAsync(CompanyId);
    }
    catch (Exception ex)
    {
      // Sin los datos de la empresa el historial se ve igual: se avisa y no se corta la pantalla.
      Snackbar.Add("No se pudieron cargar los datos de la empresa: " + ex.Message, Severity.Warning);
    }
  }

  private async Task LoadData()
  {
    _loading = true;
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      _declarations = await DeclarationService.GetDeclarationsByCompanyAsync(CompanyId);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar historial: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private bool FilterFunc(DeclarationResponseDto element)
  {
    if (string.IsNullOrWhiteSpace(_searchString))
      return true;
    if (element.Period.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
      return true;
    return false;
  }

  /// <summary>
  /// Manda a Nueva DDJJ con la empresa, el sindicato y el período ya elegidos, para hacer la rectificativa
  /// desde acá sin tener que acordarse de cuál era la empresa ni volver a elegir el período. Al presentar,
  /// el sistema detecta que ya hay una versión vigente, avisa y muestra la comparación.
  /// </summary>
  private void OnRectificar(DeclarationResponseDto declaration)
  {
    Navigation.NavigateTo(
        $"/declarations/new?empresa={declaration.CompanyId}&sindicato={declaration.UnionId}&periodo={declaration.Period}");
  }

  private Color GetStatusColor(string status)  {
    return status switch
    {
      "Draft" => Color.Warning,
      "Submitted" => Color.Info,
      "Approved" => Color.Primary,
      "Paid" => Color.Success,
      "Rejected" => Color.Error,
      // Reemplazada por una rectificativa: queda como antecedente, en gris para que no se confunda con
      // una DDJJ vigente.
      "Rectificada" => Color.Default,
      _ => Color.Default
    };
  }

  /// <summary>
  /// Imprime la boleta BANCARIA: la que va al banco con el código de barras de 58 dígitos, por
  /// triplicado. Los datos los arma BoletaService (Application) y los dibuja BoletaPdfService: la
  /// pantalla no calcula importes ni vencimientos, sólo pide y descarga.
  ///
  /// La boleta tiene UNA sola fecha de vencimiento. Si la DDJJ YA venció, antes de generarla se le
  /// pregunta al cliente cuándo va a pagar: esa fecha es el vencimiento de la boleta y hasta ahí se
  /// calcula el interés resarcitorio.
  /// </summary>
  private async Task OnImprimirBoletaBancaria(DeclarationResponseDto declaration)
  {
    try
    {
      var (cancelado, fechaPago) = await PedirFechaDePagoSiEstaVencidaAsync(declaration.Id, declaration.Period);
      if (cancelado) return;

      var armado = await BoletaService.ArmarAsync(declaration.Id, fechaPago);

      if (armado.Datos is null)
      {
        // Motivo concreto (sin configuración bancaria, período inválido, o días de mora sin tasa
        // cargada) en lugar de un PDF vacío o de un importe inventado.
        Snackbar.Add(armado.Error ?? "No se pudo armar la boleta bancaria.", Severity.Error);
        return;
      }

      var datos = armado.Datos;
      var pdfBytes = BoletaPdfService.Generar(datos);
      // Nombre pedido por el usuario: aaaa-MM_CUIT_Boleta_Pago.pdf
      var fileName = $"{datos.Periodo}_{datos.Cuit}_Boleta_Pago.pdf";
      await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, Convert.ToBase64String(pdfBytes));

      var detalleInteres = datos.Interes > 0
          ? $" Incluye interés por {datos.DiasInteres} día(s): {datos.Interes:C2} " +
            $"({datos.InteresPorcentaje:0.####}%)" +
            (string.IsNullOrWhiteSpace(datos.InteresNorma) ? "." : $" según {datos.InteresNorma}.")
          : " Sin interés.";

      Snackbar.Add(
          $"Boleta bancaria emitida. Vencimiento {datos.Vencimiento:dd/MM/yyyy} por {datos.ImporteTotal:C2}." +
          detalleInteres,
          Severity.Success);

      // Si el período de mora cruzó más de un tramo de tasa, se avisa en vez de que el desglose quede
      // escondido.
      if (!string.IsNullOrWhiteSpace(armado.Advertencia))
        Snackbar.Add(armado.Advertencia, Severity.Warning);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al generar la boleta bancaria: " + ex.Message, Severity.Error);
    }
  }

  /// <summary>
  /// Si la DDJJ ya venció, abre el modal para que se indique la fecha de pago (que será el vencimiento de
  /// la boleta). Devuelve <c>(false, null)</c> si todavía no venció (se emite con la fecha del banco), y
  /// <c>(true, _)</c> si el usuario cerró el modal sin elegir.
  /// </summary>
  private async Task<(bool Cancelado, DateTime? Fecha)> PedirFechaDePagoSiEstaVencidaAsync(int declarationId, string periodo)
  {
    var vencimiento = await BoletaService.ObtenerVencimientoAsync(declarationId);
    if (vencimiento is not { Vencida: true }) return (false, null);

    var parametros = new DialogParameters
    {
      { nameof(PaymentDateDialog.Periodo), periodo },
      { nameof(PaymentDateDialog.Vencimiento), vencimiento.Vencimiento }
    };

    var dialogo = await DialogService.ShowAsync<PaymentDateDialog>(
        "Fecha de pago de la boleta", parametros,
        new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, CloseButton = true });

    var resultado = await dialogo.Result;
    if (resultado is null || resultado.Canceled || resultado.Data is not DateTime fecha) return (true, null);

    return (false, fecha);
  }
}

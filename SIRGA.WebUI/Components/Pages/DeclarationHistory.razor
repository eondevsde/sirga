@page "/declarations/history"
@page "/empresa/{CompanyId:int}/historial"
@using SIRGA.Application.DTOs
@attribute [Authorize(Roles = "EstudioContable,Sindicato,Auditor,Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject SIRGA.Application.Services.PdfReportService PdfService
@inject SIRGA.Application.Services.DeclarationService DeclarationService
@inject SIRGA.Application.Services.BoletaService BoletaService
@inject SIRGA.WebUI.Services.BoletaPdfService BoletaPdfService
@inject IJSRuntime JSRuntime

<PageTitle>SIRGA - Historial de DDJJ</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Historial de Declaraciones Juradas</MudText>

@if (_loading)
{
  <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
  <MudTable Items="@_declarations" Hover="true" Dense="true" Elevation="1"
            Filter="new Func<DeclarationResponseDto,bool>(FilterFunc)">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Presentaciones Anteriores</MudText>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por Periodo" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>Fecha Presentación</MudTh>
      <MudTh>Periodo</MudTh>
      <MudTh>Sindicato</MudTh>
      <MudTh>Total</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh Style="text-align:right">Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Fecha">@context.SubmissionDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
      <MudTd DataLabel="Periodo">@context.Period</MudTd>
      <MudTd DataLabel="Sindicato">@context.UnionName</MudTd>
      <MudTd DataLabel="Total">@context.TotalAmount.ToString("C2")</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Text">
          @context.Status
        </MudChip>
      </MudTd>
      <MudTd DataLabel="Acciones" Style="text-align:right">
        <MudTooltip Text="Imprimir la boleta bancaria (BSE), por triplicado: cliente, banco y sindicato">
          <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Primary"
                         OnClick="@(() => OnImprimirBoletaBancaria(context))" />
        </MudTooltip>
        <MudTooltip Text="Re-descargar Boleta PDF">
          <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error"
                         OnClick="@(() => OnDownloadPdf(context))" />
        </MudTooltip>
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager InfoFormat="Mostrando {first_item}-{last_item} de {all_items}"
                     RowsPerPageString="Filas por página:" />
    </PagerContent>
  </MudTable>
}

@code {
  [Parameter] public int CompanyId { get; set; }
  private bool _loading = true;
  private string _searchString = "";
  private IEnumerable<DeclarationResponseDto> _declarations = new List<DeclarationResponseDto>();

  protected override async Task OnInitializedAsync()
  {
    await LoadData();
  }

  private async Task LoadData()
  {
    _loading = true;
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      _declarations = await DeclarationService.GetDeclarationsByCompanyAsync(CompanyId);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar historial: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private bool FilterFunc(DeclarationResponseDto element)
  {
    if (string.IsNullOrWhiteSpace(_searchString))
      return true;
    if (element.Period.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
      return true;
    return false;
  }

  private Color GetStatusColor(string status)
  {
    return status switch
    {
      "Draft" => Color.Warning,
      "Submitted" => Color.Info,
      "Paid" => Color.Success,
      "Cancelled" => Color.Error,
      _ => Color.Default
    };
  }

  private async Task OnDownloadPdf(DeclarationResponseDto declaration)
  {
    try
    {
      // Llamada directa al servicio de PDF: el endpoint ahora exige rol y el HttpClient del
      // componente no lleva la cookie de sesión.
      var pdfBytes = PdfService.GeneratePaymentBoleta(declaration);
      var fileName = $"Boleta_SIRGA_{declaration.Period}_{declaration.CompanyCuit}.pdf";
      var base64 = Convert.ToBase64String(pdfBytes);
      await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
      Snackbar.Add("Boleta generada con éxito", Severity.Success);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al generar PDF: " + ex.Message, Severity.Error);
    }
  }

  /// <summary>
  /// Imprime la boleta BANCARIA: la que va al banco con el código de barras de 58 dígitos, por
  /// triplicado. Los datos los arma BoletaService (Application) y los dibuja BoletaPdfService: la
  /// pantalla no calcula importes ni vencimientos, sólo pide y descarga.
  /// </summary>
  private async Task OnImprimirBoletaBancaria(DeclarationResponseDto declaration)
  {
    try
    {
      var armado = await BoletaService.ArmarAsync(declaration.Id);

      if (armado.Datos is null)
      {
        // Motivo concreto (sin configuración bancaria, período inválido, etc.) en lugar de un PDF vacío.
        Snackbar.Add(armado.Error ?? "No se pudo armar la boleta bancaria.", Severity.Error);
        return;
      }

      var datos = armado.Datos;
      var pdfBytes = BoletaPdfService.Generar(datos);
      var fileName = $"BoletaBancaria_{datos.Periodo}_{datos.Cuit}.pdf";
      await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, Convert.ToBase64String(pdfBytes));

      Snackbar.Add(
          $"Boleta bancaria emitida. 1° venc. {datos.PrimerVencimiento:dd/MM/yyyy}: {datos.ImportePrimerVencimiento:C2} · " +
          $"2° venc. {datos.SegundoVencimiento:dd/MM/yyyy}: {datos.ImporteSegundoVencimiento:C2}",
          Severity.Success);

      // El recargo puede salir de la tasa por defecto (la escala de AFIP no está cargada): se avisa
      // en vez de dejar una boleta con un importe provisorio sin que nadie lo sepa.
      if (!string.IsNullOrWhiteSpace(armado.Advertencia))
        Snackbar.Add(armado.Advertencia, Severity.Warning);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al generar la boleta bancaria: " + ex.Message, Severity.Error);
    }
  }
}

@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using SIRGA.Domain.Entities
@using MudBlazor
@inject EmployeeService EmpService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-3 mb-n1" />
            Nuevo Empleado
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (company != null)
        {
            <MudPaper Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Info" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Sucursal / Empresa destino:</MudText>
                        <MudText Typo="Typo.body2"><b>@company.BusinessName</b> @(string.IsNullOrEmpty(company.BranchName) ?
                                                                                      "" : $"({company.BranchName})")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Ubicación: @(company.City?.Name ?? "Sede Central")
                                @company.Address
                            </MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            }

            <MudForm @ref="form" @bind-IsValid="@success">
                <MudTextField T="string" Label="DNI" Required="true" RequiredError="DNI es requerido"
                              @bind-Value="model.Dni" HelperText="Sin puntos ni espacios" MaxLength="10" />
                <MudTextField T="string" Label="Nombre Completo" Required="true" RequiredError="El nombre es requerido"
                              @bind-Value="model.FullName" />
                <MudCheckBox T="bool" @bind-Value="model.IsVoluntaryMember" Label="Es Socio Voluntario (Aporte +2%)"
                             Color="Color.Primary" />
            
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                    El sistema asignará automáticamente el Sindicato según la ciudad de la sucursal.
                </MudAlert>
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!success)">Guardar
                Empleado</MudButton>
            </DialogActions>
        </MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int CompanyId { get; set; }

    private CreateEmployeeDto model = new();
    private Company? company;
    private bool success;
    private MudForm form = default!;

    protected override async Task OnInitializedAsync()
    {
        model.CompanyId = CompanyId;
        company = await EmpService.GetCompanyByIdAsync(CompanyId);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await EmpService.CreateEmployeeWithAssignmentAsync(model);
                Snackbar.Add($"Empleado registrado en {company?.Address ?? "Sede Central"}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error al registrar: " + ex.Message, Severity.Error);
            }
        }
    }
}








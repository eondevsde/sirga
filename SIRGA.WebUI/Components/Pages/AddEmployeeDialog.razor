@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using SIRGA.Domain.Entities
@using SIRGA.Domain.Enums
@using MudBlazor
@inject EmployeeService EmpService
@inject ISnackbar Snackbar

@* Alta y edición de empleado. Antes sólo pedía "DNI" y "Nombre Completo" (aunque en SIRGA el Dni es
   el CUIL) y no dejaba cargar ni la CATEGORÍA ni la JORNADA, que son las dos cosas que necesita la
   DDJJ: sin categoría el mínimo de escala da cero y la jornada decide si corresponde el 50%. *@
<MudDialog>
  <TitleContent>
    <div class="d-flex align-center" style="gap: 12px;">
      <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
        <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" />
      </MudAvatar>
      <div>
        <MudText Typo="Typo.h6" Class="mb-0">@(IsEdit ? "Editar empleado" : "Nuevo empleado")</MudText>
        @if (company != null)
        {
          <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @company.BusinessName@(string.IsNullOrEmpty(company.BranchName) ? "" : $" ({company.BranchName})")
          </MudText>
        }
      </div>
    </div>
  </TitleContent>
  <DialogContent>
    <MudForm @ref="form" @bind-IsValid="@success">

      <MudText Typo="Typo.overline" Color="Color.Primary">Identificación</MudText>
      <MudDivider Class="mt-1 mb-3" />
      <MudGrid>
        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="CUIL" @bind-Value="model.Dni" Required="true"
                        RequiredError="El CUIL es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                        Mask="@(new PatternMask("00-00000000-0"))" MaxLength="13"
                        Disabled="IsEdit"
                        Validation="@(new Func<string, string?>(ValidateCuil))"
                        HelperText="@(IsEdit ? "El CUIL no se edita: es la llave del empleado" : "11 dígitos")" />
        </MudItem>

        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="Apellido" @bind-Value="model.LastName" Required="true"
                        RequiredError="El apellido es obligatorio" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Person" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="Nombre" @bind-Value="model.FirstName" Required="true"
                        RequiredError="El nombre es obligatorio" Variant="Variant.Outlined"
                        Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" md="4">
          <MudSelect T="string" Label="Tipo de documento" @bind-Value="model.DocumentTypeCode"
                     Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("3")">DNI</MudSelectItem>
            <MudSelectItem Value="@("1")">LC</MudSelectItem>
            <MudSelectItem Value="@("2")">LE</MudSelectItem>
            <MudSelectItem Value="@("4")">CI</MudSelectItem>
          </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="Número de documento" @bind-Value="model.DocumentNumber"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudDatePicker @bind-Date="model.BirthDate" Label="Fecha de nacimiento" Variant="Variant.Outlined"
                         Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Editable="true" />
        </MudItem>

        <MudItem xs="12" md="4">
          <MudSelect T="string" Label="Sexo" @bind-Value="model.Sex" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("M")">Masculino</MudSelectItem>
            <MudSelectItem T="string" Value="@("F")">Femenino</MudSelectItem>
          </MudSelect>
        </MudItem>
      </MudGrid>

      <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-2">Contacto</MudText>
      <MudDivider Class="mt-1 mb-3" />
      <MudGrid>
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Celular" @bind-Value="model.Mobile" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Smartphone" />
        </MudItem>
        <MudItem xs="12" md="6">
          <MudTextField T="string" Label="Teléfono" @bind-Value="model.Phone" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Phone" />
        </MudItem>
        <MudItem xs="12">
          <MudTextField T="string" Label="Email" @bind-Value="model.Email" Variant="Variant.Outlined"
                        Margin="Margin.Dense" InputType="InputType.Email" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Email" />
        </MudItem>
        <MudItem xs="12" md="8">
          <MudTextField T="string" Label="Domicilio (calle)" @bind-Value="model.Address"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Place" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="Número" @bind-Value="model.AddressNumber"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
      </MudGrid>

      <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-2">Obra social y condiciones</MudText>
      <MudDivider Class="mt-1 mb-3" />
      <MudGrid>
        <MudItem xs="12" md="8">
          <MudSelect T="string" Label="Obra social" @bind-Value="model.HealthInsuranceCode"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @foreach (var obra in _obrasSociales)
            {
              <MudSelectItem Value="@obra.Code">@obra.Name</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center">
          <MudCheckBox T="bool" @bind-Value="model.IsRetired" Label="Es jubilado" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12">
          <MudCheckBox T="bool" @bind-Value="model.HasFamilyCharge" Label="Tiene carga familiar" Color="Color.Primary" />
        </MudItem>
      </MudGrid>

      <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-2">Situación en esta empresa</MudText>
      <MudDivider Class="mt-1 mb-3" />
      <MudGrid>
        <MudItem xs="12" md="4">
          <MudSelect T="string" Label="Categoría" @bind-Value="model.CategoryCode" Variant="Variant.Outlined"
                     Margin="Margin.Dense" Clearable="true"
                     HelperText="Sin categoría no se calcula el mínimo de escala.">
            @foreach (var categoria in _categorias)
            {
              <MudSelectItem Value="@categoria.Code">@($"{categoria.Code} — {categoria.Name}")</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
          <MudSelect T="JornadaType" Label="Jornada" @bind-Value="model.Jornada" Variant="Variant.Outlined"
                     Margin="Margin.Dense">
            <MudSelectItem Value="@JornadaType.Completa">Completa</MudSelectItem>
            <MudSelectItem Value="@JornadaType.Parcial">Parcial (50%)</MudSelectItem>
          </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
          <MudSelect T="string" Label="Actividad" @bind-Value="model.ActivityCode" Variant="Variant.Outlined"
                     Margin="Margin.Dense" Clearable="true"
                     HelperText="La actividad del convenio, distinta de la categoría.">
            @foreach (var actividad in _actividades)
            {
              <MudSelectItem Value="@actividad.Code">@actividad.Name</MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
          @* Fecha de ingreso A LA EMPRESA: de acá sale la antigüedad. Se puede escribir o elegir. *@
          <MudDatePicker @bind-Date="_fechaIngreso" Label="Ingreso a la empresa"
                         Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Editable="true" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudTextField T="string" Label="Nro. de legajo" @bind-Value="model.FileNumber"
                        Variant="Variant.Outlined" Margin="Margin.Dense"
                        HelperText="El legajo de esta empresa (puede ser distinto en otra)." />
        </MudItem>
        <MudItem xs="12">
          <MudCheckBox T="bool" @bind-Value="model.IsVoluntaryMember"
                       Label="Es socio voluntario (aporta el 2% de cuota socio)" Color="Color.Primary" />
        </MudItem>
      </MudGrid>

      @if (_categorias.Count == 0)
      {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
          Este sindicato no tiene categorías cargadas para su rama, así que no se puede elegir una.
          Cargalas desde la pantalla de categorías antes de liquidar.
        </MudAlert>
      }
      @if (!IsEdit)
      {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
          El sindicato se asigna solo, según la localidad de la sucursal.
        </MudAlert>
      }
    </MudForm>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancelar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!success || _guardando)">
      @(_guardando ? "Guardando..." : IsEdit ? "Guardar cambios" : "Guardar empleado")
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
  [Parameter] public int CompanyId { get; set; }

  /// <summary>Empleado a editar. Si viene null, el diálogo da de alta.</summary>
  [Parameter] public EmployeeDto? Empleado { get; set; }

  private bool IsEdit => Empleado != null;
  private EmployeeDto model = new();
  private Company? company;
  private List<EmployeeCategory> _categorias = new();
  private List<Activity> _actividades = new();
  private List<HealthInsurance> _obrasSociales = new();
  /// <summary>Fecha de ingreso a la empresa. Nullable porque MudDatePicker.Date lo es.</summary>
  private DateTime? _fechaIngreso;

  private bool success;
  private bool _guardando;
  private MudForm form = default!;

  protected override async Task OnInitializedAsync()
  {
    if (Empleado != null)
    {
      // Copia: si se cancela, la fila de la grilla no queda cambiada.
      model = new EmployeeDto
      {
        Id = Empleado.Id,
        Dni = Empleado.Dni,
        FullName = Empleado.FullName,
        LastName = Empleado.LastName,
        FirstName = Empleado.FirstName,
        BirthDate = Empleado.BirthDate,
        Sex = Empleado.Sex,
        DocumentTypeCode = Empleado.DocumentTypeCode,
        DocumentNumber = Empleado.DocumentNumber,
        Phone = Empleado.Phone,
        Mobile = Empleado.Mobile,
        Email = Empleado.Email,
        Address = Empleado.Address,
        AddressNumber = Empleado.AddressNumber,
        Neighborhood = Empleado.Neighborhood,
        ZipCode = Empleado.ZipCode,
        AssignmentId = Empleado.AssignmentId,

        CategoryCode = Empleado.CategoryCode,
        Jornada = Empleado.Jornada,
        IsVoluntaryMember = Empleado.IsVoluntaryMember,
        ActivityCode = Empleado.ActivityCode,
        FileNumber = Empleado.FileNumber,
        HealthInsuranceCode = Empleado.HealthInsuranceCode,
        IsRetired = Empleado.IsRetired,
        HasFamilyCharge = Empleado.HasFamilyCharge
      };
      // La fecha de ingreso se edita en un campo aparte (nullable) y se copia al modelo al guardar.
      _fechaIngreso = Empleado.AssignmentEntryDate == default ? null : Empleado.AssignmentEntryDate;

      company = await EmpService.GetCompanyByIdAsync(CompanyId);
    }
    else
    {
      company = await EmpService.GetCompanyByIdAsync(CompanyId);
      // El alta arranca con la fecha de hoy; si la persona ingresó antes, se corrige a mano.
      _fechaIngreso = DateTime.Today;
    }

    try
    {
      _categorias = await EmpService.GetCategoriesByCompanyAsync(CompanyId);
      _actividades = await EmpService.GetActivitiesAsync();
      _obrasSociales = await EmpService.GetHealthInsurancesAsync();
    }
    catch (Exception ex)
    {
      Snackbar.Add("No se pudieron cargar las categorías: " + ex.Message, Severity.Warning);
    }
  }

  private string? ValidateCuil(string value)
  {
    if (string.IsNullOrWhiteSpace(value)) return null;
    var (ok, error) = CompanyValidationService.ValidateCuit(value);
    return ok ? null : error;
  }

  private void Cancel() => MudDialog.Cancel();

  private async Task Submit()
  {
    await form.ValidateAsync();
    if (!form.IsValid) return;

    _guardando = true;
    try
    {
      if (IsEdit)
      {
        model.AssignmentEntryDate = _fechaIngreso ?? default;
        // El servicio devuelve un aviso si el padrón del sindicato no se pudo actualizar: se muestra, no se
        // esconde. El empleado ya quedó guardado igual.
        var avisoPadron = await EmpService.UpdateEmployeeAsync(model);
        Snackbar.Add("Empleado actualizado.", Severity.Success);
        if (!string.IsNullOrWhiteSpace(avisoPadron))
          Snackbar.Add(avisoPadron!, Severity.Warning, config => config.VisibleStateDuration = 10000);
      }
      else
      {
        await EmpService.CreateEmployeeWithAssignmentAsync(new CreateEmployeeDto
        {
          Dni = model.Dni,
          LastName = model.LastName ?? "",
          FirstName = model.FirstName ?? "",
          BirthDate = model.BirthDate,
          Sex = model.Sex,
          DocumentTypeCode = model.DocumentTypeCode,
          DocumentNumber = model.DocumentNumber,
          Phone = model.Phone,
          Mobile = model.Mobile,
          Email = model.Email,
          Address = model.Address,
          CategoryCode = model.CategoryCode,
          Jornada = model.Jornada,
          EntryDate = _fechaIngreso,
          ActivityCode = model.ActivityCode,
          FileNumber = model.FileNumber,
          HealthInsuranceCode = model.HealthInsuranceCode,
          IsRetired = model.IsRetired,
          HasFamilyCharge = model.HasFamilyCharge,
          CompanyId = CompanyId,
          IsVoluntaryMember = model.IsVoluntaryMember
        });
        Snackbar.Add($"Empleado registrado en {company?.BusinessName ?? "la empresa"}", Severity.Success);
      }

      MudDialog.Close(DialogResult.Ok(true));
    }
    catch (Exception ex)
    {
      // Nunca cerrar el diálogo si falló: el usuario perdería todo lo cargado.
      Snackbar.Add("Error al guardar: " + ex.Message, Severity.Error);
    }
    finally
    {
      _guardando = false;
    }
  }
}

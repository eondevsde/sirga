@page "/unions"
@using MudBlazor
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@inject UnionService UnionService
@inject UnionSubscriptionService SubscriptionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Admin,Auditor")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
  <div class="d-flex justify-space-between align-center mb-6">
    <MudText Typo="Typo.h4">Sindicatos / Uniones</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OnAddUnion">
      Nuevo Sindicato
    </MudButton>
  </div>

  <MudTable HorizontalScroll="true" Items="@_unions" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading"
            Filter="new Func<UnionDto,bool>(FilterFunc1)">
    <ToolBarContent>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>ID</MudTh>
      <MudTh>Nombre</MudTh>
      <MudTh>CCT</MudTh>
      <MudTh>Rama</MudTh>
      <MudTh>Provincia</MudTh>
      <MudTh>Ciudad</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="ID">@context.Id</MudTd>
      <MudTd DataLabel="Nombre">@context.Name</MudTd>
      <MudTd DataLabel="CCT">@context.CctCode</MudTd>
      <MudTd DataLabel="Rama">
        @if (string.IsNullOrWhiteSpace(context.RamaName))
        {
          @* Un sindicato sin rama no es lo mismo que uno con rama vacía: se dice, porque hasta que la
             tenga no se pueden colgar bien las escalas. *@
          <MudChip T="string" Size="Size.Small" Color="Color.Warning">Sin rama</MudChip>
        }
        else
        {
          @context.RamaName
        }
      </MudTd>
      <MudTd DataLabel="Provincia">@context.JurisdictionProvince</MudTd>
      <MudTd DataLabel="Ciudad">@context.JurisdictionCity</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@(context.IsActive? Color.Success: Color.Error)" Size="Size.Small">
          @(context.IsActive ? "Activo" : "Inactivo")
        </MudChip>
      </MudTd>
      <MudTd DataLabel="Acciones">
        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(() => OnEditUnion(context))" />
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                       OnClick="@(() => OnDeleteUnion(context))" />
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager />
    </PagerContent>
  </MudTable>
</MudContainer>

@code {
  private IEnumerable<UnionDto> _unions = new List<UnionDto>();
  private bool _loading = true;
  private string _searchString = "";

  protected override async Task OnInitializedAsync()
  {
    await LoadUnions();
  }

  private async Task LoadUnions()
  {
    _loading = true;
    _unions = await UnionService.GetAllAsync();
    _loading = false;
  }

  private bool FilterFunc1(UnionDto element) => FilterFunc(element, _searchString);

  private bool FilterFunc(UnionDto element, string searchString)
  {
    if (string.IsNullOrWhiteSpace(searchString)) return true;
    if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
    if (element.CctCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
    if (element.JurisdictionProvince.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
    return false;
  }

  private async Task OnAddUnion()
  {
    var parameters = new DialogParameters { ["_model"] = new UnionDto() };
    var dialog = await DialogService.ShowAsync<AddUnionDialog>("Agregar Sindicato", parameters);
    var result = await dialog.Result;

    if (result is { Canceled: false } && result.Data is UnionDto newUnion)
    {
      await UnionService.CreateAsync(newUnion);
      
      // Crear el usuario de sindicato. Llamada directa al servicio: el endpoint ahora exige rol
      // y el HttpClient del componente no lleva la cookie de sesión.
      try
      {
        var (_, yaExistia, error) = await SubscriptionService.EnsureUnionUserAsync(newUnion.AdminEmail);

        if (error != null)
        {
          Snackbar.Add("Sindicato creado, pero hubo un error al crear el usuario: " + error, Severity.Warning);
        }
        else if (yaExistia)
        {
          Snackbar.Add("Sindicato creado. El usuario ya existía.", Severity.Info);
        }
        else
        {
          Snackbar.Add("Sindicato y usuario creados con éxito. La contraseña inicial es 12345: cambiala en el primer acceso.", Severity.Success);
        }
      }
      catch (Exception ex)
      {
        Snackbar.Add("Error al crear el usuario: " + ex.Message, Severity.Error);
      }

      await LoadUnions();
    }
  }

  private async Task OnEditUnion(UnionDto union)
  {
    var parameters = new DialogParameters
    {
      ["_model"] = new UnionDto
      {
        Id = union.Id,
        Name = union.Name,
        CctCode = union.CctCode,
        JurisdictionProvince = union.JurisdictionProvince,
        JurisdictionCity = union.JurisdictionCity,
        AdminEmail = union.AdminEmail,
        IsActive = union.IsActive,
        // Estos tres tienen que venir copiados: el diálogo devuelve el DTO y UpdateAsync escribe lo que
        // traiga. Si no se copian, editar el sindicato le borra la rama (y los porcentajes) sin avisar.
        RamaId = union.RamaId,
        LawContributionPercentage = union.LawContributionPercentage,
        UnionMemberPercentage = union.UnionMemberPercentage
      }
    };
        
    var dialog = await DialogService.ShowAsync<AddUnionDialog>("Editar Sindicato", parameters);
    var result = await dialog.Result;

    if (result is { Canceled: false } && result.Data is UnionDto editedUnion)
    {
      await UnionService.UpdateAsync(editedUnion);
      Snackbar.Add("Sindicato actualizado con éxito", Severity.Success);
      await LoadUnions();
    }
  }

  private async Task OnDeleteUnion(UnionDto union)
  {
    await UnionService.DeleteAsync(union.Id);
    Snackbar.Add("Sindicato eliminado", Severity.Info);
    await LoadUnions();
  }
}

@page "/admin/payments"
@using SIRGA.Domain.Entities
@using SIRGA.Domain.Enums
@using SIRGA.Application.Services
@attribute [Authorize(Roles = "Sindicato,Auditor,Admin")]
@inject BankReconciliationService ReconciliationService
@inject PaymentService PaymentService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>SIRGA - Conciliación de Pagos</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Conciliación de Pagos</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
  <MudTabPanel Text="Pagos Recibidos">
    <MudTable HorizontalScroll="true" Items="@_payments" Dense="true" Hover="true" Loading="@_loading"
              Filter="new Func<PaymentTransaction,bool>(FilterFunc1)">
      <ToolBarContent>
        <MudText Typo="Typo.h6">Historial de Transacciones</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Buscar por Ref o Notas" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
      </ToolBarContent>
      <HeaderContent>
        <MudTh>Fecha</MudTh>
        <MudTh>Declaración</MudTh>
        <MudTh>Monto</MudTh>
        <MudTh>Método</MudTh>
        <MudTh>Referencia</MudTh>
        <MudTh>Notas</MudTh>
      </HeaderContent>
      <RowTemplate>
        <MudTd>@context.PaymentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
        <MudTd>ID: @context.DeclarationId</MudTd>
        <MudTd><b>@context.Amount.ToString("C")</b></MudTd>
        <MudTd>@context.PaymentMethod</MudTd>
        <MudTd>@context.ExternalReference</MudTd>
        <MudTd>@context.Notes</MudTd>
      </RowTemplate>
      <PagerContent>
        <MudTablePager />
      </PagerContent>
    </MudTable>
  </MudTabPanel>

  <MudTabPanel Text="Conciliación Manual">
    <MudPaper Class="pa-4">
      <MudText Typo="Typo.h6" Class="mb-4">Registrar Pago Manual</MudText>
      <MudGrid>
        <MudItem xs="12" md="4">
          <MudNumericField @bind-Value="_newPayment.DeclarationId" Label="ID de Declaración" Variant="Variant.Outlined"
                           HelperText="Ingrese el ID de la DDJJ que se abona" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudNumericField T="decimal" @bind-Value="_newPayment.Amount" Label="Monto Cobrado" Variant="Variant.Outlined"
                           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
        </MudItem>
        <MudItem xs="12" md="4">
          <MudDatePicker Label="Fecha de Pago" @bind-Date="_paymentDate" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="6">
          <MudTextField @bind-Value="_newPayment.ExternalReference" Label="Nro de Comprobante / Referencia"
                        Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="6">
          <MudSelect T="string" Label="Método de Pago" @bind-Value="_newPayment.PaymentMethod"
                     Variant="Variant.Outlined">
            <MudSelectItem Value="@("Transferencia Bancaria")" />
            <MudSelectItem Value="@("Depósito")" />
            <MudSelectItem Value="@("Efectivo en Sede")" />
            <MudSelectItem Value="@("Cheque")" />
          </MudSelect>
        </MudItem>
        <MudItem xs="12">
          <MudTextField @bind-Value="_newPayment.Notes" Label="Notas adicionales" Lines="2"
                        Variant="Variant.Outlined" />
        </MudItem>
      </MudGrid>
      <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveManualPayment"
                   StartIcon="@Icons.Material.Filled.Check">Confirmar Conciliación</MudButton>
      </div>
    </MudPaper>
  </MudTabPanel>

  <MudTabPanel Text="Importar Excel Bancario">
    <MudPaper Class="pa-4">
      <MudText Typo="Typo.h6" Class="mb-4">Conciliación Masiva (Carga de Extracto)</MudText>
      <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileSelected" Accept=".xlsx">
        <CustomContent>
          <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                     StartIcon="@Icons.Material.Filled.CloudUpload">
            Subir Archivo Excel
          </MudButton>
        </CustomContent>
      </MudFileUpload>

      @if (_reconciliationResult != null)
      {
        <MudAlert Severity="Severity.Info" Class="mt-4">
          Se encontraron @_reconciliationResult.MatchedPayments.Count pagos coincidentes.
        </MudAlert>

        <MudTable HorizontalScroll="true" Items="@_reconciliationResult.MatchedPayments" Dense="true" Class="mt-4">
          <HeaderContent>
            <MudTh>ID DDJJ</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Monto</MudTh>
            <MudTh>Ref</MudTh>
          </HeaderContent>
          <RowTemplate>
            <MudTd>@context.DeclarationId</MudTd>
            <MudTd>@context.PaymentDate.ToShortDateString()</MudTd>
            <MudTd>@context.Amount.ToString("C")</MudTd>
            <MudTd>@context.ExternalReference</MudTd>
          </RowTemplate>
        </MudTable>

        <div class="d-flex justify-end mt-4">
          <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmBulkPayments"
                     Disabled="@(!_reconciliationResult.MatchedPayments.Any())">Confirmar Todo</MudButton>
        </div>
      }
    </MudPaper>
  </MudTabPanel>
</MudTabs>

@code {
  private List<PaymentTransaction> _payments = new();
  private PaymentTransaction _newPayment = new() { PaymentDate = DateTime.Today };
  private DateTime? _paymentDate = DateTime.Today;
  private bool _loading = true;
  private string _searchString = "";
  private SIRGA.Application.Services.ReconciliationResultDto? _reconciliationResult;

  protected override async Task OnInitializedAsync()
  {
    await LoadPayments();
  }

  private async Task HandleFileSelected(IBrowserFile file)
  {
    if (file == null) return;
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      using var stream = file.OpenReadStream(10 * 1024 * 1024); // Max 10MB
      _reconciliationResult = await ReconciliationService.ProcessBankExcelAsync(stream);
      Snackbar.Add("Archivo procesado. Revise los resultados.", Severity.Success);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al importar: " + ex.Message, Severity.Error);
    }
  }

  private async Task ConfirmBulkPayments()
  {
    if (_reconciliationResult == null || !_reconciliationResult.MatchedPayments.Any()) return;

    var confirmados = await PaymentService.ConfirmBulkAsync(_reconciliationResult.MatchedPayments);
    Snackbar.Add($"Pagos procesados correctamente: {confirmados}.", Severity.Success);
    _reconciliationResult = null;
    await LoadPayments();
  }

  private async Task LoadPayments()
  {
    _loading = true;
    try
    {
      _payments = (await PaymentService.GetTransactionsAsync()).ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar pagos: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task SaveManualPayment()
  {
    if (_newPayment.DeclarationId <= 0 || _newPayment.Amount <= 0)
    {
      Snackbar.Add("Debe ingresar un ID de DDJJ y monto válido", Severity.Warning);
      return;
    }

    try
    {
      _newPayment.PaymentDate = _paymentDate ?? DateTime.Today;
      var registrado = await PaymentService.RegisterManualPaymentAsync(_newPayment);
      if (registrado != null)
      {
        Snackbar.Add("¡Pago conciliado y DDJJ actualizada!", Severity.Success);
        _newPayment = new() { PaymentDate = DateTime.Today };
        await LoadPayments();
      }
      else
      {
        Snackbar.Add("Error: la DDJJ indicada no existe.", Severity.Error);
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al registrar el pago: " + ex.Message, Severity.Error);
    }
  }

  private bool FilterFunc1(PaymentTransaction element) => FilterFunc(element, _searchString);

  private bool FilterFunc(PaymentTransaction element, string searchString)
  {
    if (string.IsNullOrWhiteSpace(searchString))
      return true;
    if (element.ExternalReference?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
      return true;
    if (element.Notes?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
      return true;
    return false;
  }
}


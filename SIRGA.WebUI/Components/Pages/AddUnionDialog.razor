@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using System.ComponentModel.DataAnnotations

<MudDialog>
  <DialogContent>
    <MudForm @ref="_form" Model="@_model">
      <MudTextField Label="Nombre del Sindicato" @bind-Value="_model.Name" For="@(() => _model.Name)" Required="true"
                    Class="mb-4" />
            
      <MudTextField Label="Código CCT" @bind-Value="_model.CctCode" For="@(() => _model.CctCode)" Required="true"
                    Class="mb-4" />

      <MudTextField Label="Provincia / Jurisdicción" @bind-Value="_model.JurisdictionProvince"
                    For="@(() => _model.JurisdictionProvince)" Required="true" Class="mb-4" />

      <MudTextField Label="Ciudad / Localidad" @bind-Value="_model.JurisdictionCity"
                    For="@(() => _model.JurisdictionCity)" Class="mb-4" />

      <MudTextField Label="Email Administrador (Usuario Sindicato)" @bind-Value="_model.AdminEmail"
                    For="@(() => _model.AdminEmail)" HelperText="Email con el que el sindicato ingresará al sistema" Class="mb-4" />

      @* Rama de actividad (el convenio). Es lo que va a permitir que las escalas cuelguen de la rama
         y no de cada sindicato: varios sindicatos comparten la misma rama. *@
      <MudSelect T="int?" Label="Rama de actividad" Value="_model.RamaId"
                 ValueChanged="@((int? v) => _model.RamaId = v)" Clearable="true"
                 HelperText="El convenio del sindicato (varios sindicatos comparten la misma rama)" Class="mb-4">
        @foreach (var rama in _ramas)
        {
          <MudSelectItem T="int?" Value="@((int?)rama.Id)">@rama.Name (@rama.Code)</MudSelectItem>
        }
      </MudSelect>

      <MudSwitch @bind-Value="_model.IsActive" Label="Activo" Color="Color.Primary" />
    </MudForm>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancelar</MudButton>
    <MudButton Color="Color.Primary" OnClick="Submit">Guardar</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
  [Parameter] public UnionDto _model { get; set; } = new();

  [Inject] private UnionService UnionService { get; set; } = null!;
  [Inject] private ISnackbar Snackbar { get; set; } = null!;

  private MudForm _form = null!;
  private List<Rama> _ramas = new();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _ramas = (await UnionService.GetRamasAsync()).ToList();
    }
    catch (Exception ex)
    {
      // Si no se pueden traer las ramas, se avisa: sin esto el combo queda vacío y parece que no hay
      // ninguna, que es distinto de que la consulta haya fallado.
      Snackbar.Add("No se pudieron cargar las ramas de actividad: " + ex.Message, Severity.Warning);
      _ramas = new();
    }
  }

  private async Task Submit()
  {
    await _form.ValidateAsync();
    if (_form.IsValid)
    {
      MudDialog.Close(DialogResult.Ok(_model));
    }
  }

  private void Cancel() => MudDialog.Cancel();
}

@page "/audit/review"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Sindicato,Admin")]
@inject HttpClient Http
@inject DeclarationService DeclarationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
  <MudText Typo="Typo.h4" Class="mb-6">Revisión y Auditoría de DDJJ</MudText>

  @* ServerData: la grilla pide de a una página al servidor. Antes se traían las 248.151
     DDJJ completas (115,68 MB y 40,5 s) y se filtraban en el navegador. *@
  <MudTable HorizontalScrollbar="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" Elevation="4"
            ServerData="LoadServerData" @ref="_table" Dense="true">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Declaraciones Pendientes de Revisión</MudText>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por CUIT o Empresa" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                    Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchChanged"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>Periodo</MudTh>
      <MudTh>Empresa</MudTh>
      <MudTh>CUIT</MudTh>
      <MudTh>Fecha Presentación</MudTh>
      <MudTh>Monto Total</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Periodo">@context.Period</MudTd>
      <MudTd DataLabel="Empresa">@context.CompanyName</MudTd>
      <MudTd DataLabel="CUIT">@context.CompanyCuit</MudTd>
      <MudTd DataLabel="Fecha">@context.SubmissionDate.ToShortDateString()</MudTd>
      <MudTd DataLabel="Monto">$ @context.TotalAmount.ToString("N2")</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@GetStatusLabel(context.Status)</MudChip>
      </MudTd>
      <MudTd>
        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" title="Ver Detalles"
                       OnClick="@(() => ViewDetails(context))" />
      </MudTd>
    </RowTemplate>
    <PagerContent>
      <MudTablePager InfoFormat="Mostrando {first_item}-{last_item} de {all_items}" RowsPerPageString="Filas:" />
    </PagerContent>
  </MudTable>
</MudContainer>

<MudDialog @bind-Visible="_detailsVisible" Options="_dialogOptions">
  <TitleContent>
    <MudText Typo="Typo.h6">
      <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-3" />
      Detalle de DDJJ: @_selectedDeclaration?.CompanyName (@_selectedDeclaration?.Period)
    </MudText>
  </TitleContent>
  <DialogContent>
    @if (_loadingDetails)
    {
      <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
      <MudTable HorizontalScrollbar="true" Items="@_details" Dense="true" Hover="true" Class="mb-4">
        <HeaderContent>
          <MudTh>Empleado</MudTh>
          <MudTh>DNI</MudTh>
          <MudTh>Sueldo Base</MudTh>
          <MudTh>Aporte Ley</MudTh>
          <MudTh>Aporte Socio</MudTh>
          <MudTh>Total</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd>@context.EmployeeName</MudTd>
          <MudTd>@context.Dni</MudTd>
          <MudTd>$ @context.BaseSalary.ToString("N2")</MudTd>
          <MudTd>$ @context.LawContribution.ToString("N2")</MudTd>
          <MudTd>
            @if (context.IsSocio)
            {
              <span>$ @context.MemberContribution.ToString("N2")</span>
            }
            else
            {
              <span style="color: gray">N/A</span>
            }
          </MudTd>
          <MudTd><strong>$ @context.TotalWithheld.ToString("N2")</strong></MudTd>
        </RowTemplate>
      </MudTable>
            
      <MudTextField T="string" Label="Observaciones de Auditoría" Variant="Variant.Outlined"
                    Lines="3" @bind-Value="_observation" />
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="CloseDetails">Cerrar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reject">Rechazar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Approve">Aprobar</MudButton>
  </DialogActions>
</MudDialog>

@code {
  private MudTable<DeclarationResponseDto> _table = null!;
  private List<DeclarationResponseDto> _declarations = new();
  private List<DeclarationDetailDto> _details = new();
  private bool _loading = true;
  private bool _loadingDetails = false;
  private string _searchString = "";
  private bool _detailsVisible = false;
  private DeclarationResponseDto? _selectedDeclaration;
  private string _observation = "";
  private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

  /// <summary>
  /// Carga de a una página: el filtro por estado, la búsqueda y el Skip/Take los resuelve
  /// la base. Antes se traían las 248.151 DDJJ (115,68 MB, 40,5 s) y se filtraban acá.
  /// </summary>
  private async Task<TableData<DeclarationResponseDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
  {
    _loading = true;
    try
    {
      var page = state.Page + 1;
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient del
      // componente no lleva la cookie de sesión.
      var result = await DeclarationService.GetDeclarationsPagedAsync(
          page, state.PageSize, "Submitted", null, null,
          string.IsNullOrWhiteSpace(_searchString) ? null : _searchString.Trim());
      if (result != null)
      {
        _declarations = result.Items;
        return new TableData<DeclarationResponseDto> { TotalItems = result.TotalCount, Items = result.Items };
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar declaraciones: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }

    return new TableData<DeclarationResponseDto> { TotalItems = 0, Items = new List<DeclarationResponseDto>() };
  }

  private async Task OnSearchChanged(string value)
  {
    if (_table != null) await _table.ReloadServerData();
  }

  private async Task ReloadTable()
  {
    if (_table != null) await _table.ReloadServerData();
  }

  private async Task ViewDetails(DeclarationResponseDto dec)
  {
    _selectedDeclaration = dec;
    _detailsVisible = true;
    _loadingDetails = true;
    _observation = "";
    try
    {
      _details = await DeclarationService.GetDeclarationDetailsAsync(dec.Id);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar detalles: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingDetails = false;
    }
  }

  private void CloseDetails() => _detailsVisible = false;

  private async Task Approve()
  {
    if (_selectedDeclaration == null) return;
        
    try
    {
      await DeclarationService.ApproveDeclarationAsync(_selectedDeclaration.Id, _observation);
      Snackbar.Add("Declaración Aprobada con éxito", Severity.Success);
      _detailsVisible = false;
      await ReloadTable();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al aprobar: " + ex.Message, Severity.Error);
    }
  }

  private async Task Reject()
  {
    if (_selectedDeclaration == null) return;
        
    if (string.IsNullOrWhiteSpace(_observation))
    {
      Snackbar.Add("Debe ingresar una observación para rechazar", Severity.Warning);
      return;
    }

    try
    {
      await DeclarationService.RejectDeclarationAsync(_selectedDeclaration.Id, _observation);
      Snackbar.Add("Declaración Rechazada", Severity.Warning);
      _detailsVisible = false;
      await ReloadTable();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al rechazar: " + ex.Message, Severity.Error);
    }
  }

  private Color GetStatusColor(string status) => status switch
  {
    "Submitted" => Color.Info,
    "Pending" => Color.Warning,
    "Approved" => Color.Success,
    "Rejected" => Color.Error,
    "Paid" => Color.Primary,
    _ => Color.Default
  };

  /// <summary>
  /// El estado viene en inglés desde el backend (es el valor del enum); en pantalla se muestra
  /// en castellano como el resto de la interfaz.
  /// </summary>
  private static string GetStatusLabel(string status) => status switch
  {
    "Draft" => "Borrador",
    "Submitted" => "Presentada",
    "Approved" => "Aprobada",
    "Rejected" => "Rechazada",
    "Paid" => "Pagada",
    _ => status
  };
}

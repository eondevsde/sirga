@page "/audit/review"
@using SIRGA.Application.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Sindicato,Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
  <MudText Typo="Typo.h4" Class="mb-6">Revisión y Auditoría de DDJJ</MudText>

  <MudTable Items="@_declarations" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" Elevation="4">
    <ToolBarContent>
      <MudText Typo="Typo.h6">Declaraciones Pendientes de Revisión</MudText>
      <MudSpacer />
      <MudTextField @bind-Value="_searchString" Placeholder="Buscar por CUIT o Empresa" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
      <MudTh>Periodo</MudTh>
      <MudTh>Empresa</MudTh>
      <MudTh>CUIT</MudTh>
      <MudTh>Fecha Presentación</MudTh>
      <MudTh>Monto Total</MudTh>
      <MudTh>Estado</MudTh>
      <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
      <MudTd DataLabel="Periodo">@context.Period</MudTd>
      <MudTd DataLabel="Empresa">@context.CompanyName</MudTd>
      <MudTd DataLabel="CUIT">@context.CompanyCuit</MudTd>
      <MudTd DataLabel="Fecha">@context.SubmissionDate.ToShortDateString()</MudTd>
      <MudTd DataLabel="Monto">$ @context.TotalAmount.ToString("N2")</MudTd>
      <MudTd DataLabel="Estado">
        <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
      </MudTd>
      <MudTd>
        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" title="Ver Detalles"
                       OnClick="@(() => ViewDetails(context))" />
      </MudTd>
    </RowTemplate>
  </MudTable>
</MudContainer>

<MudDialog @bind-Visible="_detailsVisible" Options="_dialogOptions">
  <TitleContent>
    <MudText Typo="Typo.h6">
      <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-3" />
      Detalle de DDJJ: @_selectedDeclaration?.CompanyName (@_selectedDeclaration?.Period)
    </MudText>
  </TitleContent>
  <DialogContent>
    @if (_loadingDetails)
    {
      <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
      <MudTable Items="@_details" Dense="true" Hover="true" Class="mb-4">
        <HeaderContent>
          <MudTh>Empleado</MudTh>
          <MudTh>DNI</MudTh>
          <MudTh>Sueldo Base</MudTh>
          <MudTh>Aporte Ley</MudTh>
          <MudTh>Aporte Socio</MudTh>
          <MudTh>Total</MudTh>
        </HeaderContent>
        <RowTemplate>
          <MudTd>@context.EmployeeName</MudTd>
          <MudTd>@context.Dni</MudTd>
          <MudTd>$ @context.BaseSalary.ToString("N2")</MudTd>
          <MudTd>$ @context.LawContribution.ToString("N2")</MudTd>
          <MudTd>
            @if (context.IsSocio)
            {
              <span>$ @context.MemberContribution.ToString("N2")</span>
            }
            else
            {
              <span style="color: gray">N/A</span>
            }
          </MudTd>
          <MudTd><strong>$ @context.TotalWithheld.ToString("N2")</strong></MudTd>
        </RowTemplate>
      </MudTable>
            
      <MudTextField T="string" Label="Observaciones de Auditoría" Variant="Variant.Outlined"
                    Lines="3" @bind-Value="_observation" />
    }
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="CloseDetails">Cerrar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Reject">Rechazar</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Approve">Aprobar</MudButton>
  </DialogActions>
</MudDialog>

@code {
  private List<DeclarationResponseDto> _declarations = new();
  private List<DeclarationDetailDto> _details = new();
  private bool _loading = true;
  private bool _loadingDetails = false;
  private string _searchString = "";
  private bool _detailsVisible = false;
  private DeclarationResponseDto? _selectedDeclaration;
  private string _observation = "";
  private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

  protected override async Task OnInitializedAsync()
  {
    await LoadData();
  }

  private async Task LoadData()
  {
    _loading = true;
    try
    {
      // En este prototipo traemos todas, pero en producción filtraríamos por SindicatoId del usuario logueado
      var all = await Http.GetFromJsonAsync<List<DeclarationResponseDto>>("api/declarations") ?? new();
      // Mostramos solo las que están en estado "Pending" o "Submitted"
      _declarations = all.Where(d => d.Status == "Submitted" || d.Status == "Pending").ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar declaraciones: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task ViewDetails(DeclarationResponseDto dec)
  {
    _selectedDeclaration = dec;
    _detailsVisible = true;
    _loadingDetails = true;
    _observation = "";
    try
    {
      _details = await Http.GetFromJsonAsync<List<DeclarationDetailDto>>($"api/declarations/{dec.Id}/details") ?? new();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar detalles: " + ex.Message, Severity.Error);
    }
    finally
    {
      _loadingDetails = false;
    }
  }

  private void CloseDetails() => _detailsVisible = false;

  private async Task Approve()
  {
    if (_selectedDeclaration == null) return;
        
    var request = new AuditActionRequestDto { DeclarationId = _selectedDeclaration.Id, Observation = _observation };
    var response = await Http.PostAsJsonAsync("api/declarations/approve", request);
        
    if (response.IsSuccessStatusCode)
    {
      Snackbar.Add("Declaración Aprobada con éxito", Severity.Success);
      _detailsVisible = false;
      await LoadData();
    }
    else
    {
      Snackbar.Add("Error al aprobar", Severity.Error);
    }
  }

  private async Task Reject()
  {
    if (_selectedDeclaration == null) return;
        
    if (string.IsNullOrWhiteSpace(_observation))
    {
      Snackbar.Add("Debe ingresar una observación para rechazar", Severity.Warning);
      return;
    }

    var request = new AuditActionRequestDto { DeclarationId = _selectedDeclaration.Id, Observation = _observation };
    var response = await Http.PostAsJsonAsync("api/declarations/reject", request);
        
    if (response.IsSuccessStatusCode)
    {
      Snackbar.Add("Declaración Rechazada", Severity.Warning);
      _detailsVisible = false;
      await LoadData();
    }
    else
    {
      Snackbar.Add("Error al rechazar", Severity.Error);
    }
  }

  private Color GetStatusColor(string status) => status switch
  {
    "Submitted" => Color.Info,
    "Pending" => Color.Warning,
    "Approved" => Color.Success,
    "Rejected" => Color.Error,
    "Paid" => Color.Primary,
    _ => Color.Default
  };
}

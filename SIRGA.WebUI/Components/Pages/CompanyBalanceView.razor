@page "/company/{CompanyId:int}/balance"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject BalanceService BalanceService
@inject ISnackbar Snackbar

<PageTitle>SIRGA - Estado de Cuenta</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
  <MudBreadcrumbs Items="_breadcrumbs" />
    
  @if (_data == null)
  {
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
  }
  else
  {
    <MudGrid>
      <MudItem xs="12" md="4">
        <MudPaper Class="pa-6 d-flex flex-column align-center justify-center mud-width-full"
                  Style="height: 200px; background-color: var(--mud-palette-primary-lighten); color: white;">
          <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Class="mb-2" />
          <MudText Typo="Typo.h6">CRÉDITO DISPONIBLE</MudText>
          <MudText Typo="Typo.h3" Style="font-size: clamp(1rem, 1.7vw, 1.55rem); overflow-wrap: anywhere; line-height: 1.1;"><b>@_data.CurrentCredit.ToString("C2")</b></MudText>
          <MudText Typo="Typo.caption">Última actualización: @_data.LastUpdate.ToLocalTime().ToString("g")</MudText>
        </MudPaper>
      </MudItem>

      <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Style="height: 200px;">
          <MudText Typo="Typo.h6" Class="mb-4">Información de la Empresa</MudText>
          <MudStack Spacing="1">
            <MudText><b>Razon Social:</b> @_data.BusinessName</MudText>
            <MudText><b>ID Empresa:</b> @_data.CompanyId</MudText>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
              El crédito disponible se aplicará automáticamente en su próxima declaración jurada.
            </MudAlert>
          </MudStack>
        </MudPaper>
      </MudItem>

      <MudItem xs="12">
        <MudTable HorizontalScrollbar="true" Items="@_data.Movements" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="4" Dense="true">
          <ToolBarContent>
            <MudText Typo="Typo.h6">Historial de Movimientos</MudText>
            <MudSpacer />
          </ToolBarContent>
          <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Concepto</MudTh>
            <MudTh>DDJJ Ref.</MudTh>
            <MudTh>Monto</MudTh>
            <MudTh>Tipo</MudTh>
          </HeaderContent>
          <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Concepto">@context.Concept</MudTd>
            <MudTd DataLabel="DDJJ Ref.">
              @if (context.DeclarationId.HasValue)
              {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">ID:
                  @context.DeclarationId</MudChip>
                }
                            else
                {
                  <MudText Typo="Typo.caption">N/A</MudText>
                }
              </MudTd>
              <MudTd DataLabel="Monto">
                <MudText Color="@(context.Amount >= 0 ? Color.Success : Color.Error)">
                  <b>@Math.Abs(context.Amount).ToString("C2")</b>
                </MudText>
              </MudTd>
              <MudTd DataLabel="Tipo">
                <MudChip T="string" Size="Size.Small" Color="@(context.Amount >= 0 ? Color.Success : Color.Error)">
                  @(context.Amount >= 0 ? "CRÉDITO" : "UBO/DÉBITO")
                </MudChip>
              </MudTd>
            </RowTemplate>
            <PagerContent>
              <MudTablePager InfoFormat="Mostrando {first_item}-{last_item} de {all_items}"
                             RowsPerPageString="Filas por página:" />
            </PagerContent>
          </MudTable>
        </MudItem>
      </MudGrid>
    }
  </MudContainer>

@code {
  [Parameter] public int CompanyId { get; set; }
  private CompanyBalanceDto? _data;
  private List<BreadcrumbItem> _breadcrumbs = new();

  protected override async Task OnInitializedAsync()
  {
    _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Empresas", href: "/companies"),
            new BreadcrumbItem("Estado de Cuenta", href: null, disabled: true)
        };

    await LoadData();
  }

  private async Task LoadData()
  {
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige sesión y el HttpClient no lleva cookie.
      _data = await BalanceService.GetFullStatementAsync(CompanyId);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar estado de cuenta: " + ex.Message, Severity.Error);
    }
  }
}

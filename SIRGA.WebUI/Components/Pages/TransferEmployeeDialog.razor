@using SIRGA.Domain.Entities
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@inject CompanyService CompanyService
@inject EmployeeService EmployeeService
@inject ISnackbar Snackbar

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">Transferir Empleado</MudText>
  </TitleContent>
  <DialogContent>
    <MudText Class="mb-4">Vas a transferir a <b>@EmployeeName</b> de sucursal.</MudText>
    <MudForm @ref="_form" @bind-IsValid="@_success">
      <MudGrid>
        <MudItem xs="12">
          <MudSelect T="int" Label="Sucursal de Destino" @bind-Value="_targetCompanyId" Required="true"
                     Variant="Variant.Outlined">
            @foreach (var company in _availableCompanies)
            {
              <MudSelectItem Value="@company.Id">
                @company.BusinessName @(string.IsNullOrEmpty(company.BranchName) ? "" : $" - {company.BranchName}")
              </MudSelectItem>
            }
          </MudSelect>
        </MudItem>
        <MudItem xs="12">
          <MudAlert Severity="Severity.Info">
            Nota: Si la sucursal de destino está en otra localidad, el sindicato asignado podría cambiar automáticamente
            según la jurisdicción.
          </MudAlert>
        </MudItem>
      </MudGrid>
    </MudForm>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancelar</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(_processing || !_success)">
      @if (_processing)
      {
        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
        <MudText Class="ms-2">Procesando...</MudText>
      }
      else
      {
        <MudText>Confirmar Transferencia</MudText>
      }
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter] public int EmployeeId { get; set; }
  [Parameter] public string EmployeeName { get; set; } = "";
  [Parameter] public int CurrentCompanyId { get; set; }

  private MudForm _form = null!;
  private bool _success;
  private bool _processing;
  private int _targetCompanyId;
  private List<Company> _availableCompanies = new();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      // Llamada directa al servicio: el endpoint de empresas ahora exige rol y el HttpClient de
      // los componentes no lleva la cookie de sesión.
      var todas = (await CompanyService.GetAllAsync()).ToList();

      // Regla de negocio: el traspaso mueve al empleado entre SUCURSALES DE LA MISMA EMPRESA.
      // Se resuelve la casa central (la raíz) de la empresa actual y sólo se ofrecen sus sucursales
      // activas, sin incluir la actual. Antes se ofrecían TODAS las empresas activas del sistema,
      // incluidas las de otros estudios contables: eso permitía mover un empleado a una empresa ajena.
      var actual = todas.FirstOrDefault(c => c.Id == CurrentCompanyId);
      var casaCentralId = actual?.ParentCompanyId ?? CurrentCompanyId;

      _availableCompanies = todas
          .Where(c => c.Id != CurrentCompanyId
                   && c.Status == SIRGA.Domain.Enums.CompanyStatus.Active
                   && (c.Id == casaCentralId || c.ParentCompanyId == casaCentralId))
          .ToList();
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar sucursales: " + ex.Message, Severity.Error);
    }
  }

  private async Task Submit()
  {
    _processing = true;
    try
    {
      // Llamada directa al servicio: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      await EmployeeService.TransferEmployeeAsync(EmployeeId, CurrentCompanyId, _targetCompanyId);
            
      Snackbar.Add("Empleado transferido exitosamente", Severity.Success);
      MudDialog.Close(DialogResult.Ok(true));
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al transferir: " + ex.Message, Severity.Error);
    }
    finally
    {
      _processing = false;
    }
  }

  private void Cancel() => MudDialog.Cancel();
}

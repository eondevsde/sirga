@page "/reports/collections"
@using SIRGA.Application.DTOs
@using SIRGA.Application.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Sindicato,Admin")]
@inject HttpClient Http
@inject AuditService AuditService
@inject IReportService ReportService
@inject DebtNotificationService DebtNotificationService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>SIRGA - Reportes de Recaudación</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
  <MudText Typo="Typo.h4" Class="mb-6">Reportes y Estadísticas de Recaudación</MudText>

  @if (_data == null)
  {
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
  }
  else
  {
    <MudGrid>
      <!-- Resumen de KPIs -->
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="height:120px; border-top: 4px solid var(--mud-palette-primary)">
          <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="fw-bold">RECAUDACIÓN TOTAL</MudText>
            <MudText Typo="Typo.h4" Style="font-size: clamp(1rem, 1.7vw, 1.55rem); overflow-wrap: anywhere; line-height: 1.1;">@_data.TotalCollected.ToString("C0")</MudText>
            <MudText Typo="Typo.caption">Total histórico acumulado</MudText>
          </MudStack>
        </MudPaper>
      </MudItem>
            
      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="height:120px; border-top: 4px solid var(--mud-palette-secondary)">
          <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="fw-bold">TOTAL DECLARACIONES</MudText>
            <MudText Typo="Typo.h4" Style="font-size: clamp(1rem, 1.7vw, 1.55rem); overflow-wrap: anywhere; line-height: 1.1;">@_data.TotalDeclarations</MudText>
            <MudText Typo="Typo.caption">Presentaciones procesadas</MudText>
          </MudStack>
        </MudPaper>
      </MudItem>

      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="height:120px; border-top: 4px solid var(--mud-palette-info)">
          <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="fw-bold">EMPRESAS ACTIVAS</MudText>
            <MudText Typo="Typo.h4" Style="font-size: clamp(1rem, 1.7vw, 1.55rem); overflow-wrap: anywhere; line-height: 1.1;">@_data.CompaniesCount</MudText>
            <MudText Typo="Typo.caption">Padrón de empleadores</MudText>
          </MudStack>
        </MudPaper>
      </MudItem>

      <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="height:120px; border-top: 4px solid var(--mud-palette-success)">
          <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2" Color="Color.Success" Class="fw-bold">AFILIADOS TOTALES</MudText>
            <MudText Typo="Typo.h4" Style="font-size: clamp(1rem, 1.7vw, 1.55rem); overflow-wrap: anywhere; line-height: 1.1;">@_data.ActiveEmployees</MudText>
            <MudText Typo="Typo.caption">Trabajadores bajo convenio</MudText>
          </MudStack>
        </MudPaper>
      </MudItem>

      <!-- Gráfico de Evolución Mensual -->
      <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Style="height:450px;">
          <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Evolución de Recaudación Mensual</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Primary" OnClick="DownloadCollectionsExcel"
                           title="Descargar Excel" />
          </MudStack>
          <MudChart ChartType="ChartType.Line" ChartSeries="@_series" ChartLabels="@_xAxisLabels" Width="100%"
                    Height="350px" />
        </MudPaper>
      </MudItem>

      <!-- Listado de Deudores -->
      <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Style="height:450px;">
          <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6" Color="Color.Error">Top Deudores Estimados</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Email" Color="Color.Error" OnClick="NotifyDebtors"
                           title="Notificar por Email" />
          </MudStack>
          <MudTable HorizontalScrollbar="true" Items="@_data.Debtors.Take(10)" Dense="true" Hover="true" FixedHeader="true" Height="330px"
                    Elevation="0">
            <HeaderContent>
              <MudTh>Empresa</MudTh>
              <MudTh>Deuda + Int.</MudTh>
            </HeaderContent>
            <RowTemplate>
              <MudTd>@context.BusinessName</MudTd>
              <MudTd>
                <MudText Typo="Typo.body2" Color="Color.Error"><b>@((context.EstimatedDebt +
                                    context.Interests).ToString("C0"))</b></MudText>
                </MudTd>
              </RowTemplate>
            </MudTable>
          </MudPaper>
        </MudItem>
      </MudGrid>
    }
  </MudContainer>

@code {
  private AuditDashboardDto? _data;
  private List<ChartSeries<double>> _series = new();
  private string[] _xAxisLabels = Array.Empty<string>();

  protected override async Task OnInitializedAsync()
  {
    await LoadData();
  }

  private async Task LoadData()
  {
    try
    {
      _data = await AuditService.GetStatsAsync();
      if (_data != null)
      {
        PrepareChart();
      }
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al cargar reportes: " + ex.Message, Severity.Error);
    }
  }

  private void PrepareChart()
  {
    if (_data == null || !_data.MonthlyCollections.Any()) return;

    var collections = _data.MonthlyCollections.OrderBy(c => c.Period).ToList();
    _xAxisLabels = collections.Select(c => c.Period).ToArray();
        
    _series = new List<ChartSeries<double>>
        {
            new ChartSeries<double>
            {
                Name = "Recaudación ($)",
                Data = collections.Select(c => (double)c.Amount).ToArray()
            }
        };
  }

  private async Task DownloadCollectionsExcel()
  {
    try
    {
      // Llamada directa a los servicios: el endpoint ahora exige rol y el HttpClient no lleva cookie.
      var stats = await AuditService.GetStatsAsync();
      var bytes = await ReportService.ExportCollectionsToExcelAsync(
          stats.MonthlyCollections, "Resumen de Recaudación Mensual");
      await DownloadFile($"Recaudacion_{DateTime.Now:yyyyMMdd}.xlsx", bytes);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error al exportar: " + ex.Message, Severity.Error);
    }
  }

  private async Task NotifyDebtors()
  {
    try
    {
      // Llamada directa al servicio: el endpoint HTTP ahora exige rol y el HttpClient del
      // componente no lleva la cookie de sesión.
      var enviados = await DebtNotificationService.NotifyAllDebtorsAsync();
      Snackbar.Add($"Notificaciones enviadas: {enviados}.", Severity.Success);
    }
    catch (Exception ex)
    {
      Snackbar.Add("Error: " + ex.Message, Severity.Error);
    }
  }

  private async Task DownloadFile(string fileName, byte[] bytes)
  {
    await JS.InvokeVoidAsync("BlazorDownloadFile", fileName,
"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF Core registra cada sentencia SQL en nivel Information: en producción eso
      // genera muchísimo volumen de log y cuesta rendimiento. Se silencia a Warning.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
